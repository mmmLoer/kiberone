# Example peer config for wg1 (80.90.188.85:51821).
# Copy to C:\ProgramData\KIBERone\VpnAgent\peer.conf and fill real keys / Address.
# File name without extension becomes the tunnel service suffix (WireGuardTunnel$peer).

[Interface]
PrivateKey = REPLACE_WITH_PEER_PRIVATE_KEY
Address = 10.200.0.N/32
DNS = 1.1.1.1

[Peer]
PublicKey = REPLACE_WITH_WG1_SERVER_PUBLIC_KEY
Endpoint = 80.90.188.85:51821
AllowedIPs = 10.200.0.0/24
PersistentKeepalive = 25
