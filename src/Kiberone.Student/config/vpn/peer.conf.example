# Example peer config for wg1 (80.90.188.85:51821).
# Install with scripts/install-student-vpn.ps1 to:
#   C:\ProgramData\KIBERone\Student\vpn\peer.conf
# Or let Tutor push a config automatically from the VPN configs folder.

# AllowedIPs: use 10.200.0.0/24 for VPN-only, or leave 0.0.0.0/0 and KIBERone
# will auto-replace it with a classroom split (internet via VPN, LAN stays local).

[Interface]
PrivateKey = REPLACE_WITH_PEER_PRIVATE_KEY
Address = 10.200.0.N/32
DNS = 1.1.1.1

[Peer]
PublicKey = REPLACE_WITH_WG1_SERVER_PUBLIC_KEY
Endpoint = 80.90.188.85:51821
AllowedIPs = 10.200.0.0/24
PersistentKeepalive = 25
