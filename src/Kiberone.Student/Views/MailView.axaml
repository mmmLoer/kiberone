<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kiberone.Student.ViewModels" xmlns:views="using:Kiberone.Student.Views" xmlns:core="using:Kiberone.Core" x:Class="Kiberone.Student.Views.MailView" x:DataType="vm:MainViewModel" x:Name="MailRoot" x:CompileBindings="True">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24" Spacing="22">
  <StackPanel IsVisible="{Binding IsInboxVisible}" Spacing="22">
   <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="ЛИЧНАЯ ПОЧТА" Classes="eyebrow"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding MailAddress}" Classes="h2" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Скопировать адрес" Command="{Binding CopyMailAddressCommand}" IsEnabled="{Binding HasMailAccount}" Classes="ghost" Margin="16,0,0,0"/></Grid><Separator/><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="ПАРОЛЬ ОТ ПОЧТЫ" Classes="eyebrow"/><TextBlock Text="•••• •••• •••• ••••" FontSize="22" FontWeight="Bold"/></StackPanel><Button Grid.Column="1" Content="Скопировать пароль" Command="{Binding CopyMailPasswordCommand}" IsEnabled="{Binding HasMailAccount}" Classes="ghost"/></Grid></StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Входящие" Classes="h2"/><TextBlock Grid.Column="1" Text="{Binding MailUnreadLabel}" Foreground="#068F8A" FontSize="12"/></Grid><Separator/>
     <ItemsControl ItemsSource="{Binding MailMessages}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MailMessageCard">
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14" Margin="0,0,0,12" Command="{Binding #MailRoot.((vm:MainViewModel)DataContext).OpenMailMessageCommand}" CommandParameter="{Binding}">
       <Grid ColumnDefinitions="42,*,Auto"><Border Width="42" Height="42" Background="#E0F5F2" CornerRadius="10"><TextBlock Text="{Binding Initial}" Foreground="#068F8A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="4" Margin="12,0"><TextBlock Text="{Binding Sender}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subject}" TextWrapping="Wrap"/><TextBlock Text="{Binding Preview}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Date}" Classes="muted" FontSize="11"/></Grid>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="Обновить ↻" Command="{Binding RefreshMailCommand}" Classes="ghost" IsEnabled="{Binding !MailBusy}"/>
    </StackPanel></Border>
  </StackPanel>
  <StackPanel IsVisible="{Binding IsMessageVisible}" Spacing="20"><Button Content="← Все письма" Command="{Binding CloseMailMessageCommand}" HorizontalAlignment="Left"/><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{Binding SelectedMailMessage.Sender}" FontWeight="Bold"/><TextBlock Text="{Binding SelectedMailMessage.Subject}" Classes="h1" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedMailMessage.Date}" Classes="muted"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="20"><views:MailContent x:Name="MailRenderer" Html="{Binding SelectedMailMessage.HtmlBody}" Height="650" IsVisible="{Binding SelectedMailMessage.HasHtml}"/><TextBlock IsVisible="{Binding !#MailRenderer.IsReady}" Text="{Binding SelectedMailMessage.Body}" TextWrapping="Wrap" FontSize="15"/><ItemsControl IsVisible="{Binding !#MailRenderer.IsReady}" ItemsSource="{Binding SelectedMailMessage.Links}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:StudentMailLink"><Button Content="{Binding Label}" Command="{Binding #MailRoot.((vm:MainViewModel)DataContext).OpenMailLinkCommand}" CommandParameter="{Binding}" Classes="primary" Margin="0,0,0,10" HorizontalAlignment="Left"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Background="#E0F5F2" CornerRadius="14" Padding="20" IsVisible="{Binding SelectedMailMessage.HasCode}"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="8"><TextBlock Text="НАЙДЕННЫЙ КОД" Classes="eyebrow"/><TextBlock Text="{Binding SelectedMailMessage.Code}" FontSize="30" FontWeight="Bold"/></StackPanel><Button Grid.Column="1" Content="Скопировать код" Command="{Binding CopyMailCodeCommand}" Classes="primary" VerticalAlignment="Center"/></Grid></Border></StackPanel></Border></StackPanel>
  <Border Classes="softCard" Padding="14"><TextBlock Text="{Binding MailStatus}" Classes="muted" TextWrapping="Wrap"/></Border>
 </StackPanel></ScrollViewer>
</UserControl>
