<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kiberone.Student.ViewModels"
        x:Class="Kiberone.Student.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1360"
        Height="900"
        MinWidth="980"
        MinHeight="680"
        Title="KIBERone Classroom — Ученик"
        Focusable="True"
        x:Name="StudentRoot">
  <Grid RowDefinitions="72,*" ColumnDefinitions="208,*">

    <!-- Product header -->
    <Border Grid.ColumnSpan="2"
            Background="White"
            BorderBrush="#E1E7EA"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="208,*,Auto" Margin="24,0">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="KIBER" Classes="brand"/>
            <TextBlock Text="ONE" FontSize="20" FontWeight="Bold"/>
          </StackPanel>
          <TextBlock Text="УЧЕНИК" Classes="eyebrow" Foreground="#6B7880"/>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding SectionTitle}" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="{Binding SectionSubtitle}"
                     Classes="muted"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border Grid.Column="2"
                Classes="statusPill"
                Background="{Binding ConnectionBackground}"
                VerticalAlignment="Center">
          <StackPanel Spacing="1" MaxWidth="270">
            <TextBlock Text="{Binding ConnectionLabel}"
                       Foreground="{Binding ConnectionForeground}"
                       FontWeight="Bold"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding SyncLabel}"
                       Classes="muted"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Four clear destinations instead of a second tab strip. -->
    <Border Grid.Row="1"
            Background="#FBFCFC"
            BorderBrush="#E1E7EA"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="14,24,14,16">
        <TextBlock Text="МОЁ ПРОСТРАНСТВО"
                   Classes="eyebrow"
                   Foreground="#87939A"
                   Margin="10,0,0,12"/>

        <StackPanel Grid.Row="1">
          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="0"
                  Classes="nav"
                  Classes.active="{Binding IsHomeSection}"
                  ToolTip.Tip="Главная">
            <Grid ColumnDefinitions="30,*">
              <Border Width="26" Height="26" Background="#E9F5F4" CornerRadius="8">
                <TextBlock Text="⌂" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#068F8A" FontSize="15"/>
              </Border>
              <TextBlock Grid.Column="1" Text="Главная" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
          </Button>

          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="1"
                  Classes="nav"
                  Classes.active="{Binding IsLessonsSection}"
                  ToolTip.Tip="Выбрать или продолжить урок">
            <Grid ColumnDefinitions="30,*">
              <Border Width="26" Height="26" Background="#FFF3C9" CornerRadius="8">
                <TextBlock Text="⌨" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8B6500" FontSize="14"/>
              </Border>
              <TextBlock Grid.Column="1" Text="Уроки печати" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
          </Button>

          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="6"
                  Classes="nav"
                  Classes.active="{Binding IsProfileSection}"
                  ToolTip.Tip="Профиль, прогресс и цели">
            <Grid ColumnDefinitions="30,*">
              <Border Width="26" Height="26" Background="#EDF1F3" CornerRadius="8">
                <TextBlock Text="●" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6B7880" FontSize="11"/>
              </Border>
              <TextBlock Grid.Column="1" Text="Профиль" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
          </Button>

          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="7"
                  Classes="nav"
                  Classes.active="{Binding IsConnectionSection}"
                  ToolTip.Tip="Связь с Tutor и обновления">
            <Grid ColumnDefinitions="30,*">
              <Border Width="26" Height="26" Background="#E9F5F4" CornerRadius="8">
                <TextBlock Text="↗" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#068F8A" FontSize="14"/>
              </Border>
              <TextBlock Grid.Column="1" Text="Подключение" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
          </Button>
        </StackPanel>

        <Border Grid.Row="2" Classes="softCard" Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="СТАТУС КЛАССА" Classes="eyebrow" FontSize="9"/>
            <TextBlock Text="{Binding CurrentStudentGroup}"
                       FontWeight="SemiBold"
                       FontSize="12"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding UpdateLabel}"
                       Classes="muted"
                       FontSize="10"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1"
                Grid.Column="1"
                SelectedIndex="{Binding SelectedSectionIndex}"
                Classes="contentOnly">

      <!-- Home -->
      <TabItem Header="Главная">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <Grid ColumnDefinitions="3*,2*"
                Margin="28"
                MaxWidth="1180"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
            <Border Classes="card" Margin="0,0,18,0" VerticalAlignment="Top">
              <StackPanel Spacing="20">
                <StackPanel Spacing="7">
                  <TextBlock Text="СЕГОДНЯ" Classes="eyebrow"/>
                  <TextBlock Text="{Binding Greeting}" Classes="h1"/>
                  <TextBlock Text="Начни с короткой разминки или дождись задания тьютора."
                             Classes="muted"
                             FontSize="16"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <Border Classes="softCard">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="ТВОЙ ПРОГРЕСС" Classes="eyebrow" Foreground="#6B7880"/>
                        <TextBlock Text="{Binding LevelLabel}" FontSize="22" FontWeight="Bold"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding BalanceLabel}"
                                 FontSize="26"
                                 FontWeight="Bold"
                                 Foreground="#C08400"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar Value="{Binding LevelProgress}" Maximum="100" Height="9"/>
                    <TextBlock Text="{Binding LevelProgressLabel}" Classes="muted" FontSize="12"/>
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                  <Button Content="Выбрать тренировку"
                          Command="{Binding NavigateCommand}"
                          CommandParameter="1"
                          Classes="primary"
                          Margin="0,0,8,0"/>
                  <Button Grid.Column="1"
                          Content="Посмотреть прогресс"
                          Command="{Binding NavigateCommand}"
                          CommandParameter="6"
                          Classes="secondary"
                          Margin="8,0,0,0"/>
                </Grid>

                <Border Background="#FFF7DB"
                        BorderBrush="#F4DA84"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16">
                  <Grid ColumnDefinitions="32,*">
                    <Border Width="26" Height="26" CornerRadius="8" Background="#FFB80D">
                      <TextBlock Text="!" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="Новое задание тьютора появится в разделе «Уроки печати»."
                               Foreground="#6D5311"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Spacing="18">
              <Border Classes="card">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Моя цель" Classes="h2"/>
                    <Border Grid.Column="1" Background="#FFF3C9" CornerRadius="999" Padding="9,5" VerticalAlignment="Center">
                      <TextBlock Text="ЦЕЛЬ" FontSize="9" FontWeight="Bold" Foreground="#8B6500" VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                  <TextBlock Text="Наушники" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="1 420 ₭" FontSize="28" FontWeight="Bold" Foreground="#C08400"/>
                  <ProgressBar Value="{Binding GoalProgress}" Maximum="100" Height="8" Foreground="#FFB80D"/>
                  <TextBlock Text="{Binding GoalRemainder}" Foreground="#056D69" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="11">
                  <TextBlock Text="Класс" Classes="h2"/>
                  <TextBlock Text="{Binding CurrentStudentGroup}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding ConnectionForeground}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SyncLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                  <Button Content="Проверить подключение"
                          Command="{Binding NavigateCommand}"
                          CommandParameter="7"
                          Classes="secondary"
                          HorizontalAlignment="Stretch"
                          Margin="0,4,0,0"/>
                  <Button Content="Установить обновление"
                          Command="{Binding InstallUpdateCommand}"
                          IsVisible="{Binding HasUpdate}"
                          Classes="primary"
                          HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- Practice library from Tutor -->
      <TabItem Header="Выбор урока">
        <ScrollViewer>
          <StackPanel Margin="28"
                      MaxWidth="1040"
                      HorizontalAlignment="Stretch"
                      Spacing="22">
            <StackPanel Spacing="6">
              <TextBlock Text="Уроки тьютора" Classes="h1"/>
              <TextBlock Text="{Binding TutorLessonsStatus}"
                         Classes="muted"
                         FontSize="15"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <Border Background="#E0F5F2"
                    BorderBrush="#C7E8E5"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
              <Grid ColumnDefinitions="30,*">
                <TextBlock Text="✓" FontWeight="Bold" Foreground="#068F8A" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="Список обновляется сам, пока есть связь с Tutor. Выбери урок — и сразу жми пробел, чтобы начать."
                           Foreground="#056D69"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding TutorLessons}" IsVisible="{Binding HasTutorLessons}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TutorLessonCardViewModel">
                  <Button Command="{Binding #StudentRoot.DataContext.SelectTutorLessonCommand}"
                          CommandParameter="{Binding}"
                          Classes="lesson">
                    <Grid ColumnDefinitions="46,*">
                      <Border Width="38" Height="38" Background="#E0F5F2" CornerRadius="10">
                        <TextBlock Text="✎" FontSize="16" FontWeight="Bold" Foreground="#068F8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="5" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="220"/>
                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="220"/>
                        <TextBlock Text="{Binding Details}" Foreground="#068F8A" FontSize="11" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border IsVisible="{Binding HasNoTutorLessons}" Classes="card" Padding="18">
              <StackPanel Spacing="8">
                <TextBlock Text="Уроков пока нет" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="{Binding TutorLessonsStatus}" Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Ready screen without full-text preview -->
      <TabItem Header="Назначенный урок">
        <ScrollViewer>
          <Border Classes="card"
                  MaxWidth="640"
                  Margin="28"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top">
            <StackPanel Spacing="22">
              <StackPanel Spacing="7">
                <TextBlock Text="ГОТОВО К СТАРТУ" Classes="eyebrow"/>
                <TextBlock Text="{Binding LessonName}" Classes="h1" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LessonMeta}" Classes="muted" FontSize="14"/>
              </StackPanel>

              <Border Background="#172126" CornerRadius="12" Padding="28">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                  <TextBlock Text="Нажмите ПРОБЕЛ"
                             Foreground="White"
                             FontSize="28"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Текст урока откроется уже в тренажёре — по одной строке."
                             Foreground="#9DB0B8"
                             FontSize="14"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"/>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="Auto,*">
                <Button Content="Назад"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="1"
                        Classes="secondary"
                        MinWidth="110"
                        Margin="0,0,12,0"/>
                <Button Grid.Column="1"
                        Content="Открыть тренажёр"
                        Command="{Binding StartAssignedLessonCommand}"
                        Classes="primary"
                        Height="48"/>
              </Grid>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <!-- Stamina-style typing trainer -->
      <TabItem Header="Урок печати">
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <StackPanel Margin="28,20"
                      MaxWidth="1160"
                      HorizontalAlignment="Stretch"
                      Spacing="16">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding LessonName}" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Grid.Column="1"
                      Background="#172126"
                      CornerRadius="10"
                      Padding="18,9"
                      VerticalAlignment="Center"
                      Margin="12,0">
                <TextBlock Text="{Binding ElapsedLabel}"
                           Foreground="White"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
              </Border>
              <Button Grid.Column="2"
                      Content="Пауза"
                      Command="{Binding PauseLessonCommand}"
                      IsEnabled="{Binding IsLessonStarted}"
                      Classes="secondary"
                      VerticalAlignment="Center"/>
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*,*">
              <Border Classes="metric" Margin="0,0,6,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="Скорость" Classes="muted" FontSize="11"/>
                  <TextBlock Text="{Binding Cpm, StringFormat={}{0:0} CPM}" Classes="metricValue"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="metric" Margin="6,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="Точность" Classes="muted" FontSize="11"/>
                  <TextBlock Text="{Binding Accuracy, StringFormat={}{0:0.#}%}" Classes="metricValue"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="metric" Margin="6,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="Прогресс" Classes="muted" FontSize="11"/>
                  <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" Classes="metricValue"/>
                  <TextBlock Text="{Binding GoalLabel}" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Classes="metric" Margin="6,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="Серия" Classes="muted" FontSize="11"/>
                  <TextBlock Text="{Binding CurrentStreak}" Classes="metricValue"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="metric" Margin="6,0,0,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="Ошибки" Classes="muted" FontSize="11"/>
                  <TextBlock Text="{Binding WrongKeys}" FontSize="24" FontWeight="Bold" Foreground="#C9362B"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="card" Padding="22" MinHeight="120">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="Следующая клавиша" Classes="muted" FontSize="12"/>
                    <Border Background="#FFB80D" CornerRadius="7" Padding="9,4">
                      <TextBlock Text="{Binding CurrentCharacter}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontWeight="Bold"
                                 FontSize="16"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{Binding LastInputFeedback}"
                             Foreground="#056D69"
                             FontWeight="SemiBold"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding TextGlyphs}" HorizontalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TypingGlyphViewModel">
                      <Border Background="{Binding Background}" CornerRadius="5" Padding="2,2" Margin="1" MinWidth="{Binding GlyphMinWidth}">
                        <TextBlock Text="{Binding Character}"
                                   Foreground="{Binding Foreground}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextDecorations="{Binding Decoration}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8"/>
              </StackPanel>
            </Border>

            <Border Background="#FFE8E5"
                    BorderBrush="#F0B6B0"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12"
                    IsVisible="{Binding HasLayoutWarning}">
              <TextBlock Text="{Binding LayoutWarning}"
                         Foreground="#A82E27"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"/>
            </Border>

            <Border Background="#E9F8F6"
                    BorderBrush="#CBE9E6"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    HorizontalAlignment="Center">
              <ItemsControl ItemsSource="{Binding KeyboardRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KeyboardRowViewModel">
                    <Border Margin="0,0,0,4">
                      <ItemsControl ItemsSource="{Binding Keys}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:KeyboardKeyViewModel">
                            <Border Width="{Binding Width}"
                                    Height="38"
                                    Background="{Binding Background}"
                                    BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="2"
                                    BoxShadow="0 2 0 0 #B7C3C8">
                              <TextBlock Text="{Binding Label}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="11"
                                         FontWeight="SemiBold"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <Grid ColumnDefinitions="*,Auto,*">
              <Border Grid.Column="1" Classes="softCard" Padding="14,9">
                <TextBlock Text="ПРОБЕЛ — старт   ·   ESC — пауза   ·   Backspace отключён"
                           Classes="muted"
                           FontSize="11"
                           FontWeight="SemiBold"/>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Pause -->
      <TabItem Header="Пауза">
        <ScrollViewer>
          <Border Classes="card"
                  MaxWidth="600"
                  Margin="28"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top">
            <StackPanel Spacing="18">
              <Border Width="54" Height="54" CornerRadius="16" Background="#FFF3C9" HorizontalAlignment="Left">
                <TextBlock Text="Ⅱ" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8B6500"/>
              </Border>
              <StackPanel Spacing="5">
                <TextBlock Text="Урок на паузе" Classes="h1"/>
                <TextBlock Text="Результат сохранён. Отдохни и продолжай, когда будешь готов."
                           Classes="muted"
                           FontSize="15"
                           TextWrapping="Wrap"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,*,*">
                <Border Classes="metric" Margin="0,0,6,0">
                  <StackPanel><TextBlock Text="Скорость" Classes="muted" FontSize="11"/><TextBlock Text="{Binding Cpm, StringFormat={}{0:0} CPM}" Classes="metricValue"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric" Margin="6,0">
                  <StackPanel><TextBlock Text="Точность" Classes="muted" FontSize="11"/><TextBlock Text="{Binding Accuracy, StringFormat={}{0:0}%}" Classes="metricValue"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="metric" Margin="6,0,0,0">
                  <StackPanel><TextBlock Text="Знаков" Classes="muted" FontSize="11"/><TextBlock Text="{Binding CorrectKeys}" Classes="metricValue"/></StackPanel>
                </Border>
              </Grid>
              <Button Content="Продолжить урок" Command="{Binding ResumeLessonCommand}" Classes="primary" Height="48"/>
              <Button Content="Завершить попытку" Command="{Binding FinishAttemptCommand}" Classes="secondary" Height="46"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <!-- Results -->
      <TabItem Header="Итоги">
        <ScrollViewer>
          <Grid ColumnDefinitions="2*,3*"
                Margin="28"
                MaxWidth="1040"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
            <Border Classes="card" Margin="0,0,18,0">
              <StackPanel Spacing="17">
                <Border Width="54" Height="54" CornerRadius="16" Background="#E0F5F2" HorizontalAlignment="Left">
                  <TextBlock Text="✓" FontSize="22" FontWeight="Bold" Foreground="#068F8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Сессия завершена" Classes="h1" TextWrapping="Wrap"/>
                <TextBlock Text="Результат готов к синхронизации с Tutor." Classes="muted" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Cpm, StringFormat={}{0:0} CPM}" Foreground="#068F8A" FontSize="34" FontWeight="Bold" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding Accuracy, StringFormat={}{0:0}% точность}" Foreground="#1F8E5B" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding CorrectKeys, StringFormat={}{0} знаков}" FontSize="18" FontWeight="SemiBold"/>
                <Button Content="Выбрать новый урок" Command="{Binding NavigateCommand}" CommandParameter="1" Classes="primary" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="14">
                <TextBlock Text="Лидеры занятия" Classes="h2"/>
                <TextBlock Text="Рейтинг показывает сильную сторону каждого ученика." Classes="muted" FontSize="12"/>
                <Border Background="#FFF7DB" BorderBrush="#F4DA84" BorderThickness="1" CornerRadius="11" Padding="16">
                  <Grid ColumnDefinitions="32,*,Auto">
                    <TextBlock Text="1" FontSize="18" FontWeight="Bold" Foreground="#8B6500" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Петрова Софья" FontWeight="SemiBold"/><TextBlock Text="Точность" Classes="muted" FontSize="11"/></StackPanel>
                    <TextBlock Grid.Column="2" Text="Лидер" Foreground="#8B6500" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <Border Classes="softCard" Padding="16">
                  <Grid ColumnDefinitions="32,*">
                    <TextBlock Text="2" FontSize="18" FontWeight="Bold" Foreground="#6B7880" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Иванов Артём" FontWeight="SemiBold"/><TextBlock Text="Скорость" Classes="muted" FontSize="11"/></StackPanel>
                  </Grid>
                </Border>
                <Border Classes="softCard" Padding="16">
                  <Grid ColumnDefinitions="32,*">
                    <TextBlock Text="3" FontSize="18" FontWeight="Bold" Foreground="#6B7880" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Смирнов Лев" FontWeight="SemiBold"/><TextBlock Text="Объём" Classes="muted" FontSize="11"/></StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- Profile -->
      <TabItem Header="Профиль и цели">
        <ScrollViewer>
          <StackPanel Margin="28"
                      MaxWidth="1080"
                      HorizontalAlignment="Stretch"
                      Spacing="20">
            <Border Classes="card">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="64" Height="64" Background="#E0F5F2" CornerRadius="20">
                  <TextBlock Text="●" Foreground="#068F8A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CurrentStudentName}" Classes="h1"/>
                  <TextBlock Text="{Binding CurrentStudentGroup}" Classes="muted"/>
                  <TextBlock Text="{Binding LevelLabel}" Foreground="#068F8A" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="БАЛАНС" Classes="eyebrow" Foreground="#8B6500" HorizontalAlignment="Right"/>
                  <TextBlock Text="{Binding BalanceLabel}" FontSize="30" FontWeight="Bold" Foreground="#C08400"/>
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="Мои достижения" Classes="h2"/>
            <Grid ColumnDefinitions="*,*,*">
              <Border Classes="achievement" Margin="0,0,8,0">
                <StackPanel Spacing="7">
                  <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="#068F8A"/>
                  <TextBlock Text="Точный старт" FontWeight="SemiBold"/>
                  <TextBlock Text="Первый урок без спешки" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="achievement" Margin="8,0">
                <StackPanel Spacing="7">
                  <TextBlock Text="◉" FontSize="20" FontWeight="Bold" Foreground="#068F8A"/>
                  <TextBlock Text="Фокус" FontWeight="SemiBold"/>
                  <TextBlock Text="Работа без отвлечений" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="achievement" Margin="8,0,0,0">
                <StackPanel Spacing="7">
                  <TextBlock Text="↗" FontSize="20" FontWeight="Bold" Foreground="#068F8A"/>
                  <TextBlock Text="Синхронизация" FontWeight="SemiBold"/>
                  <TextBlock Text="Проект сохранён в Tutor" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock Text="Цели накопления" Classes="h2" Margin="0,5,0,0"/>
            <Grid ColumnDefinitions="*,*">
              <Border Background="#FFF7DB" BorderBrush="#F4DA84" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,9,0">
                <StackPanel Spacing="11">
                  <TextBlock Text="ТЕКУЩАЯ ЦЕЛЬ" Classes="eyebrow" Foreground="#8B6500"/>
                  <TextBlock Text="Наушники · 1 420 ₭" FontWeight="SemiBold" FontSize="17"/>
                  <TextBlock Text="{Binding GoalRemainder}" Foreground="#056D69"/>
                  <ProgressBar Value="{Binding GoalProgress}" Maximum="100" Height="8" Foreground="#FFB80D"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card" Padding="22" Margin="9,0,0,0">
                <StackPanel Spacing="11">
                  <TextBlock Text="СЛЕДУЮЩАЯ ЦЕЛЬ" Classes="eyebrow" Foreground="#6B7880"/>
                  <TextBlock Text="Рюкзак · 1 600 ₭" FontWeight="SemiBold" FontSize="17"/>
                  <TextBlock Text="Можно выбрать после наушников" Classes="muted"/>
                  <ProgressBar Value="{Binding CurrentStudentKiberons}" Maximum="1600" Height="8" Foreground="#FFB80D"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Connection -->
      <TabItem Header="Техническое состояние">
        <ScrollViewer>
          <StackPanel Margin="28"
                      Spacing="18"
                      MaxWidth="780"
                      HorizontalAlignment="Center">
            <Border Classes="card">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="5">
                    <TextBlock Text="Подключение к классу" Classes="h1"/>
                    <TextBlock Text="Student находит Tutor автоматически в локальной сети."
                               Classes="muted"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                  <Border Grid.Column="1"
                          Classes="statusPill"
                          Background="{Binding ConnectionBackground}"
                          VerticalAlignment="Top">
                    <TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding ConnectionForeground}" FontWeight="Bold" FontSize="11"/>
                  </Border>
                </Grid>

                <Border Classes="softCard">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Синхронизация" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SyncLabel}" Classes="muted" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding VpnLabel}" Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding UpdateLabel}" Classes="muted" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                </Border>

                <Button Content="Проверить подключение"
                        Command="{Binding RetryConnectionCommand}"
                        Classes="primary"
                        HorizontalAlignment="Left"
                        MinWidth="210"/>
                <TextBlock Text="{Binding ConnectionActionMessage}"
                           Classes="muted"
                           FontSize="12"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Background="#FFF2F0"
                    BorderBrush="#F0C0BA"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22"
                    IsVisible="{Binding IsOffline}">
              <Grid ColumnDefinitions="42,*">
                <Border Width="34" Height="34" CornerRadius="10" Background="#FFE1DD">
                  <TextBlock Text="!" Foreground="#B52E27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0">
                  <TextBlock Text="Tutor пока не найден" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="Результаты остаются на этом компьютере. После восстановления связи очередь отправится автоматически."
                             Classes="muted"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Как работает подключение" Classes="h2"/>
                <TextBlock Text="Student сам находит Tutor в общей локальной сети. Адрес и токен класса защищены, поэтому их нельзя изменить случайно."
                           Classes="muted"
                           TextWrapping="Wrap"/>
                <Border Classes="softCard" Padding="14">
                  <Grid ColumnDefinitions="30,*">
                    <TextBlock Text="✓" Foreground="#068F8A" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="После восстановления связи сохранённые результаты отправятся автоматически."
                               Foreground="#056D69"
                               TextWrapping="Wrap"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Quiz modal -->
    <Border Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Background="#B8172126"
            IsVisible="{Binding IsQuizVisible}"
            ZIndex="900">
      <Border Classes="card"
              Padding="28"
              Width="620"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="ВИКТОРИНА" Classes="eyebrow"/>
          <TextBlock Text="{Binding QuizQuestion}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="Выбери один вариант ответа." Classes="muted"/>
          <ListBox ItemsSource="{Binding QuizOptions}"
                   SelectedItem="{Binding SelectedQuizOption}"
                   MinHeight="120"
                   BorderBrush="#DDE5E8"
                   BorderThickness="1"
                   CornerRadius="10"/>
          <TextBlock Text="{Binding QuizFeedback}" Foreground="#056D69"/>
          <Button Content="Отправить ответ" Command="{Binding SubmitQuizCommand}" Classes="primary"/>
        </StackPanel>
      </Border>
    </Border>

    <!-- Tutor notification -->
    <Border Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Background="#B8172126"
            IsVisible="{Binding IsNotificationVisible}"
            ZIndex="1050">
      <Border Classes="card"
              Padding="30"
              Width="620"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <Border Width="46" Height="46" Background="#E0F5F2" CornerRadius="14" HorizontalAlignment="Left">
            <TextBlock Text="↗" Foreground="#068F8A" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Сообщение от тьютора" Classes="h2"/>
          <TextBlock Text="{Binding NotificationText}"
                     FontSize="21"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"/>
          <Button Content="Понятно" Command="{Binding DismissNotificationCommand}" Classes="primary"/>
        </StackPanel>
      </Border>
    </Border>

    <!-- Login -->
    <Border Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Background="#F1F5F6"
            IsVisible="{Binding IsLoginVisible}"
            ZIndex="1100">
      <Border Background="White"
              BorderBrush="#E0E7EA"
              BorderThickness="1"
              CornerRadius="18"
              BoxShadow="0 18 48 0 #1813181D"
              Width="760"
              MinHeight="420"
              ClipToBounds="True"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Grid ColumnDefinitions="270,*">
          <Border Background="#068F8A" Padding="28">
            <StackPanel Spacing="20">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="KIBER" Foreground="White" FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="ONE" Foreground="#FFCF47" FontSize="21" FontWeight="Bold"/>
              </StackPanel>
              <TextBlock Text="Твоё место в классе" Foreground="White" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
              <TextBlock Text="Выбери себя один раз — прогресс, награды и уроки будут сохраняться автоматически."
                         Foreground="#D5F0ED"
                         FontSize="14"
                         TextWrapping="Wrap"
                         LineHeight="21"/>
              <Border Background="#24FFFFFF" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                <StackPanel Spacing="5">
                  <TextBlock Text="КЛАСС" Foreground="#BCE5E1" FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
                  <TextBlock Text="{Binding ConnectionLabel}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="1" Margin="34" Spacing="14" VerticalAlignment="Center">
            <StackPanel Spacing="5">
              <TextBlock Text="Добро пожаловать" Classes="h1"/>
              <TextBlock Text="Группа уже выбрана для урока. Можно сменить, если пришли на отработку." Classes="muted"/>
            </StackPanel>

            <Border Background="#F4F8F8" CornerRadius="12" Padding="12,10">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="24" Height="24" CornerRadius="100" Background="#068F8A">
                  <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Группа" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ComboBox ItemsSource="{Binding LoginGroups}"
                      SelectedItem="{Binding SelectedLoginGroup}"
                      PlaceholderText="Выбери группу"
                      HorizontalAlignment="Stretch"/>

            <Border Background="#F4F8F8" CornerRadius="12" Padding="12,10" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="24" Height="24" CornerRadius="100" Background="#068F8A">
                  <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Имя в группе" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ComboBox ItemsSource="{Binding LoginStudents}"
                      SelectedItem="{Binding SelectedStudent}"
                      PlaceholderText="Выбери себя"
                      HorizontalAlignment="Stretch"/>

            <TextBlock Text="{Binding LoginMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
            <Button Content="Войти в класс"
                    Command="{Binding ConfirmStudentCommand}"
                    Classes="primary"
                    Height="48"
                    HorizontalAlignment="Stretch"
                    Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- Lock is intentionally the highest layer: no dialog can bypass Tutor lock. -->
    <Border Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Background="#F2172126"
            IsVisible="{Binding IsScreenLocked}"
            ZIndex="1300">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="18"
                  MaxWidth="620">
        <Border Width="64" Height="64" CornerRadius="20" Background="#26FFFFFF" HorizontalAlignment="Center">
          <TextBlock Text="■" Foreground="#FFD52E" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="ЭКРАН ЗАБЛОКИРОВАН"
                   Foreground="#FFD52E"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding LockMessage}"
                   Foreground="White"
                   FontSize="18"
                   TextWrapping="Wrap"
                   TextAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
