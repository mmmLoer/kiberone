<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Kiberone.Tutor.ViewModels" x:Class="Kiberone.Tutor.Views.ActionAuthorizationView" x:DataType="vm:MainViewModel" KeyboardNavigation.TabNavigation="Cycle">
 <Border Background="#80000000" Padding="24">
  <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
   <StackPanel Spacing="16">
    <TextBlock Text="Подтвердите действие" Classes="h2"/>
    <TextBlock Text="{Binding AuthorizationAction}" TextWrapping="Wrap"/>
    <TextBox x:Name="PasswordInput" Text="{Binding AuthorizationPassword}" PasswordChar="•" Watermark="Пароль локации" IsEnabled="{Binding !AuthorizationBusy}"/>
    <TextBlock Text="{Binding AuthorizationError}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/>
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding AuthorizationBusy}"/>
    <Grid ColumnDefinitions="*,*">
     <Button Content="Отмена" Command="{Binding CancelActionAuthorizationCommand}" HorizontalAlignment="Stretch" Classes="ghost"/>
     <Button Grid.Column="1" Content="Подтвердить" Command="{Binding ConfirmActionAuthorizationCommand}" HorizontalAlignment="Stretch" Classes="primary" Margin="12,0,0,0"/>
    </Grid>
   </StackPanel>
  </Border>
 </Border>
</UserControl>
