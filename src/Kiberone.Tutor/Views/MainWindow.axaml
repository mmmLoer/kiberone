<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kiberone.Tutor.ViewModels"
        x:Class="Kiberone.Tutor.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1360" Height="900" MinWidth="980" MinHeight="640"
        Title="KIBERone Classroom — Тьютор"
        x:Name="TutorRoot">
  <Grid ColumnDefinitions="192,*" RowDefinitions="76,*">
    <Border Grid.RowSpan="2" Classes="sidebar" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="76,*,Auto" Margin="14,0,14,18">
        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="KIBER" FontSize="20" FontWeight="ExtraBold" Classes="teal" />
            <TextBlock Text="ONE" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource BrandInkBrush}" />
          </StackPanel>
          <TextBlock Text="CLASSROOM · ТЬЮТОР" Classes="eyebrow" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="ОСНОВНОЕ" Classes="eyebrow" Margin="13,4,0,6"/>
            <Button Content="Класс сейчас" Command="{Binding NavigateCommand}" CommandParameter="0" Classes="nav compact" Classes.active="{Binding IsSection0}"/>
            <Button Content="Ученики и группы" Command="{Binding NavigateCommand}" CommandParameter="2" Classes="nav compact" Classes.active="{Binding IsSection2}"/>
            <Button Content="Уроки печати" Command="{Binding NavigateCommand}" CommandParameter="1" Classes="nav compact" Classes.active="{Binding IsSection1}"/>

            <TextBlock Text="УПРАВЛЕНИЕ" Classes="eyebrow" Margin="13,14,0,6"/>
            <Button Content="Пульт класса" Command="{Binding NavigateCommand}" CommandParameter="6" Classes="nav compact" Classes.active="{Binding IsSection6}"/>
            <Button Content="Викторины" Command="{Binding NavigateCommand}" CommandParameter="9" Classes="nav compact" Classes.active="{Binding IsSection9}"/>

            <TextBlock Text="АНАЛИТИКА" Classes="eyebrow" Margin="13,14,0,6"/>
            <Button Content="Награды и магазин" Command="{Binding NavigateCommand}" CommandParameter="3" Classes="nav compact" Classes.active="{Binding IsSection3}"/>
            <Button Content="Цели" Command="{Binding NavigateCommand}" CommandParameter="14" Classes="nav compact" Classes.active="{Binding IsSection14}"/>
            <Button Content="Достижения" Command="{Binding NavigateCommand}" CommandParameter="16" Classes="nav compact" Classes.active="{Binding IsSection16}"/>

            <TextBlock Text="ДАННЫЕ" Classes="eyebrow" Margin="13,14,0,6"/>
            <Button Content="Сохранения" Command="{Binding NavigateCommand}" CommandParameter="4" Classes="nav compact" Classes.active="{Binding IsSection4}"/>
            <Button Content="Модули и версии" Command="{Binding NavigateCommand}" CommandParameter="12" Classes="nav compact" Classes.active="{Binding IsSection12}"/>
            <Button Content="Сравнение версии" Command="{Binding NavigateCommand}" CommandParameter="13" Classes="nav compact" Classes.active="{Binding IsSection13}"/>
            <Button Content="Журнал аудита" Command="{Binding NavigateCommand}" CommandParameter="17" Classes="nav compact" Classes.active="{Binding IsSection17}"/>

            <TextBlock Text="СИСТЕМА" Classes="eyebrow" Margin="13,14,0,6"/>
            <Button Content="Сервер и локация" Command="{Binding NavigateCommand}" CommandParameter="11" Classes="nav compact" Classes.active="{Binding IsSection11}"/>
            <Button Content="Настройки" Command="{Binding NavigateCommand}" CommandParameter="15" Classes="nav compact" Classes.active="{Binding IsSection15}"/>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource ServerBadgeBrush}" BorderBrush="{DynamicResource ServerBadgeBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="13,11">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="9" Height="9" CornerRadius="100" Background="{DynamicResource TealBrush}" VerticalAlignment="Top" Margin="0,5,9,0" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Сервер · 8765" FontWeight="Bold" FontSize="13" />
              <TextBlock Text="{Binding ConnectedClientLabel}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Column="1" Classes="headerBar" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="24,0">
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="КОНСОЛЬ ТЬЮТОРА" Classes="eyebrow" Margin="0,0,0,3" />
          <TextBlock Text="{Binding SectionTitle}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding SectionSubtitle}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding ThemeToggleLabel}" Command="{Binding ToggleThemeCommand}" Classes="ghost" MinHeight="34" Padding="12,6" FontSize="12" Margin="0,4,10,4" />
          <Border Background="{DynamicResource MintBrush}" CornerRadius="100" Padding="12,7" Margin="0,4,10,4" IsVisible="{Binding !HasError}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Border Width="8" Height="8" CornerRadius="100" Background="{DynamicResource TealBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Система готова" Classes="teal" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerSoftBorderBrush}" BorderThickness="1" CornerRadius="100" Padding="12,7" Margin="0,4,0,4" IsVisible="{Binding HasError}" ToolTip.Tip="{Binding StatusMessage}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Border Width="8" Height="8" CornerRadius="100" Background="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Требуется внимание" Foreground="{DynamicResource DangerTextBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </WrapPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding SelectedSectionIndex}" Classes="contentOnly">
      <TabItem Header="Класс">
        <Grid Margin="32,32" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="58" Height="58" CornerRadius="14" Background="{DynamicResource MintBrush}">
              <TextBlock Text="{Binding ConnectedClientCount}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="teal" FontSize="26" FontWeight="ExtraBold" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,3,0,0" Spacing="3">
              <TextBlock Text="Класс готов к занятию" FontSize="22" FontWeight="Bold" />
              <TextBlock Text="{Binding ConnectedClientLabel}" Classes="muted" FontSize="14" />
            </StackPanel>
            <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
              <Border Classes="segmentBar" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="Список" Command="{Binding ShowClassRosterViewCommand}" Classes="segment" Classes.active="{Binding IsClassRosterMode}" />
                  <Button Content="Экраны" Command="{Binding ShowClassScreensViewCommand}" Classes="segment" Classes.active="{Binding IsClassScreensMode}" />
                </StackPanel>
              </Border>
              <Button Content="Обновить" Command="{Binding RefreshScreenGridCommand}" Classes="ghost" IsVisible="{Binding ShowClassScreens}" Margin="0,4,0,4" />
            </WrapPanel>
          </Grid>

          <Grid Grid.Row="1" Margin="0,20,0,0" RowDefinitions="Auto,*" IsVisible="{Binding ShowClassRoster}">
            <ItemsControl ItemsSource="{Binding ClassNotices}" IsVisible="{Binding HasClassNotices}" Margin="0,0,0,12">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClassNoticeViewModel">
                  <Border Classes="notice">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Скрыть" Classes="ghost" MinHeight="28" Padding="10,4" FontSize="12"
                              VerticalAlignment="Center"
                              Command="{Binding #TutorRoot.DataContext.DismissClassNoticeCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <SplitView Grid.Row="1" DisplayMode="Inline" PanePlacement="Right" OpenPaneLength="280" CompactPaneLength="0"
                       IsPaneOpen="{Binding IsClassPanelOpen}">
              <SplitView.Pane>
                <Border Classes="card" Margin="16,0,0,0" Padding="18">
                  <ScrollViewer>
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding ClassPanelTitle}" Classes="h2" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding ClassPanelSubtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Classes="ghost" MinHeight="32" Width="36" Padding="0,1,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Command="{Binding CloseClassPanelCommand}" />
                      </Grid>

                      <StackPanel Spacing="6" IsVisible="{Binding HasSelectedClassStudent}">
                        <TextBlock Text="Этому ученику" Classes="eyebrow" />
                        <Button Content="Заблокировать экран" Classes="commandRow" Command="{Binding StudentLockCommand}" CommandParameter="{Binding SelectedClassStudent}" />
                        <Button Content="Разблокировать экран" Classes="commandRow" Command="{Binding StudentUnlockCommand}" CommandParameter="{Binding SelectedClassStudent}" />
                        <Button Content="Watchdog вкл" Classes="commandRow" Command="{Binding StudentWatchdogOnCommand}" CommandParameter="{Binding SelectedClassStudent}" />
                        <Button Content="Watchdog выкл" Classes="commandRow" Command="{Binding StudentWatchdogOffCommand}" CommandParameter="{Binding SelectedClassStudent}" />
                        <Button Content="Фокус вкл" Classes="commandRow" Command="{Binding StudentFocusOnCommand}" CommandParameter="{Binding SelectedClassStudent}" />
                        <Button Content="Фокус выкл" Classes="commandRow" Command="{Binding StudentFocusOffCommand}" CommandParameter="{Binding SelectedClassStudent}" />
                        <Button Content="Синхронизировать" Classes="commandRow" Command="{Binding StudentSyncCommand}" CommandParameter="{Binding SelectedClassStudent}" />
                        <Button Content="Отправить сообщение" Classes="commandRow" Command="{Binding StudentMessageCommand}" CommandParameter="{Binding SelectedClassStudent}" />
                        <Button Content="Папка ученика" Classes="commandRow" Command="{Binding OpenStudentFolderCommand}" CommandParameter="{Binding SelectedClassStudent}" />
                      </StackPanel>

                      <StackPanel Spacing="6">
                        <TextBlock Text="Всему классу" Classes="eyebrow" />
                        <Button Content="Заблокировать экраны" Classes="commandRow" Command="{Binding LockAllCommand}" />
                        <Button Content="Разблокировать экраны" Classes="commandRow" Command="{Binding UnlockAllCommand}" />
                        <Button Content="Watchdog вкл" Classes="commandRow" Command="{Binding WatchdogAllOnCommand}" />
                        <Button Content="Watchdog выкл" Classes="commandRow" Command="{Binding WatchdogAllOffCommand}" />
                        <Button Content="Фокус вкл" Classes="commandRow" Command="{Binding FocusAllOnCommand}" />
                        <Button Content="Синхронизировать всех" Classes="commandRow" Command="{Binding SyncAllNowCommand}" />
                        <TextBox Text="{Binding ClassroomMessage}" Watermark="Сообщение классу" />
                        <Button Content="Отправить всем" Classes="primary commandRow" Command="{Binding SendMessageAllCommand}" HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </SplitView.Pane>

              <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Состав класса" Classes="h2" />
                      <TextBlock Text="Онлайн, батарея и время последнего обновления" Classes="muted" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Команды" Classes="ghost" VerticalAlignment="Top" Command="{Binding SelectClassStudentCommand}" CommandParameter="{Binding SelectedClassStudent}" />
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,14,0,12">
                    <StackPanel Spacing="4" Margin="0,0,8,0">
                      <TextBlock Text="Текущая группа" Classes="muted" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding ActiveClassGroup}" PlaceholderText="Для входа учеников" HorizontalAlignment="Stretch" MinWidth="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,8,0">
                      <TextBlock Text="Фильтр группы" Classes="muted" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      <ComboBox ItemsSource="{Binding RosterGroupFilters}" SelectedItem="{Binding SelectedRosterGroupFilter}" HorizontalAlignment="Stretch" MinWidth="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Text="Статус" Classes="muted" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      <ComboBox ItemsSource="{Binding RosterPresenceFilters}" SelectedItem="{Binding SelectedRosterPresenceFilter}" HorizontalAlignment="Stretch" MinWidth="0" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Row="2">
                    <ScrollViewer IsVisible="{Binding HasClassRosterStudents}">
                      <ItemsControl ItemsSource="{Binding ClassRosterStudents}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:StudentCardViewModel">
                            <Button Classes="listCard" HorizontalContentAlignment="Stretch"
                                    Command="{Binding #TutorRoot.DataContext.SelectClassStudentCommand}"
                                    CommandParameter="{Binding}">
                              <Border Classes="listCardInner" Padding="12,10" Classes.selected="{Binding IsClassSelected}">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" MinWidth="72" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="100" Background="{DynamicResource TealBrush}" IsVisible="{Binding IsOnline}" />
                                    <Border Width="10" Height="10" CornerRadius="100" Background="{DynamicResource OfflineDotBrush}" IsVisible="{Binding IsOffline}" />
                                  </Grid>
                                  <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PresenceLabel}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="2" Text="{Binding Group}" Foreground="{DynamicResource TealBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" Margin="0,0,10,0" />
                                  <Border Grid.Column="3" Classes="pill" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding BatteryLabel}" FontSize="12" FontWeight="Bold" />
                                  </Border>
                                  <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="4" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding LastUpdateLabel}" Classes="muted" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasActiveModes}">
                                      <Border Classes="modeIcon" IsVisible="{Binding IsScreenLocked}" ToolTip.Tip="Экран заблокирован">
                                        <TextBlock Text="🔒" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      </Border>
                                      <Border Classes="modeIcon" IsVisible="{Binding IsWatchdogOn}" ToolTip.Tip="Watchdog включён">
                                        <TextBlock Text="🐕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      </Border>
                                      <Border Classes="modeIcon" IsVisible="{Binding IsFocusOn}" ToolTip.Tip="Фокус включён">
                                        <TextBlock Text="◎" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TealBrush}" />
                                      </Border>
                                      <Border Classes="modeIcon" IsVisible="{Binding IsVpnOn}" ToolTip.Tip="VPN включён">
                                        <TextBlock Text="🛡" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      </Border>
                                    </StackPanel>
                                  </StackPanel>
                                  <TextBlock Grid.Column="5" Text="⋯" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <Border IsVisible="{Binding HasNoClassRosterStudents}" Classes="subcard" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                      <StackPanel Spacing="7">
                        <TextBlock Text="Нет учеников по фильтру" FontWeight="Bold" />
                        <TextBlock Text="Смените группу или статус — либо добавьте ученика." Classes="muted" TextWrapping="Wrap" />
                        <Button Content="Добавить ученика" Command="{Binding NavigateCommand}" CommandParameter="2" HorizontalAlignment="Left" Margin="0,4,0,0" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </SplitView>
          </Grid>

          <Grid Grid.Row="1" Margin="0,24,0,0" IsVisible="{Binding ShowClassScreens}">
            <ScrollViewer IsVisible="{Binding HasScreenPreviews}">
              <ItemsControl ItemsSource="{Binding ScreenPreviews}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ScreenPreviewCardViewModel">
                    <Button Classes="listCard" Width="246" Margin="0,0,20,24">
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                          <MenuItem Header="{Binding Title}" IsEnabled="False" />
                          <MenuItem Header="Заблокировать экран" Command="{Binding #TutorRoot.DataContext.PcLockCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Разблокировать экран" Command="{Binding #TutorRoot.DataContext.PcUnlockCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Watchdog вкл" Command="{Binding #TutorRoot.DataContext.PcWatchdogOnCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Watchdog выкл" Command="{Binding #TutorRoot.DataContext.PcWatchdogOffCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Фокус вкл" Command="{Binding #TutorRoot.DataContext.PcFocusOnCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Фокус выкл" Command="{Binding #TutorRoot.DataContext.PcFocusOffCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Синхронизировать" Command="{Binding #TutorRoot.DataContext.PcSyncCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Отправить сообщение" Command="{Binding #TutorRoot.DataContext.PcMessageCommand}" CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Header="Папка ученика на сервере" Command="{Binding #TutorRoot.DataContext.OpenPcFolderCommand}" CommandParameter="{Binding}" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <Border Classes="card" Width="246" Height="168" Padding="10">
                        <StackPanel Spacing="7">
                          <Grid Height="108" Background="{DynamicResource PreviewPanelBrush}">
                            <TextBlock Text="Ожидаем первый снимок…" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                          </Grid>
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="⋯" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" />
                          </Grid>
                          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TealBrush}" FontSize="11" />
                        </StackPanel>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border IsVisible="{Binding HasNoScreenPreviews}" Classes="card" HorizontalAlignment="Stretch" VerticalAlignment="Top">
              <StackPanel Spacing="8">
                <TextBlock Text="Экранов пока нет" FontWeight="Bold" />
                <TextBlock Text="Как только ученики подключатся и отправят снимок, сетка появится здесь." Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Уроки печати">
    <Grid RowDefinitions="Auto,*" Margin="32,32">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Уроки печати" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Редактор маршрутов и статистика выбранной группы" Classes="muted" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Column="1" Classes="segmentBar" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Content="Редактор" Command="{Binding ShowTypingEditorViewCommand}" Classes="segment" Classes.active="{Binding IsTypingEditorMode}" />
            <Button Content="Статистика" Command="{Binding ShowTypingStatsViewCommand}" Classes="segment" Classes.active="{Binding IsTypingStatsMode}" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" IsVisible="{Binding ShowTypingEditor}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.35*" MinWidth="0" />
          <ColumnDefinition Width="*" MinWidth="0" />
        </Grid.ColumnDefinitions>
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel>
            <TextBlock Text="Мои уроки" Classes="h2" />
            <TextBlock Text="Черновики и опубликованные маршруты" Classes="muted" Margin="0,4,0,16" />
          </StackPanel>
          <Border Grid.Row="1" Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          </Border>
          <Grid Grid.Row="2">
            <ScrollViewer IsVisible="{Binding HasLessons}">
              <ItemsControl ItemsSource="{Binding Lessons}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LessonCardViewModel">
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="{Binding Details}" Classes="muted" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource TealBrush}" FontWeight="Bold" FontSize="12" Margin="0,8,0,0" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="{DynamicResource AmberSoftBrush}" CornerRadius="100" Padding="8,4" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Version}" FontWeight="Bold" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border IsVisible="{Binding HasNoLessons}" Classes="subcard" VerticalAlignment="Top">
              <StackPanel Spacing="7">
                <TextBlock Text="Уроков пока нет" FontWeight="Bold" />
                <TextBlock Text="Заполните маршрут справа и сохраните его. Он сразу появится в этом списке." Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
          <Button Grid.Row="3" Content="Обновить список" Command="{Binding RefreshCommand}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Margin="22,0,0,0">
        <ScrollViewer>
          <StackPanel Spacing="16">
            <StackPanel>
              <TextBlock Text="Новый маршрут" Classes="h2" />
              <TextBlock Text="Разбейте урок на этапы — прогресс сохранится отдельно по каждому." Classes="muted" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*">
              <StackPanel Spacing="6">
                <TextBlock Text="Название" FontWeight="Bold" />
                <TextBox Text="{Binding LessonName}" Watermark="Например, Циклы Python" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6" Margin="14,0,0,0">
                <TextBlock Text="Описание" FontWeight="Bold" />
                <TextBox Text="{Binding Description}" Watermark="Что тренируем" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
              <StackPanel Spacing="6">
                <TextBlock Text="Тип" FontWeight="Bold" />
                <ComboBox ItemsSource="{Binding LessonKinds}" SelectedItem="{Binding SelectedLessonKind}" MinWidth="0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0">
                <TextBlock Text="Раскладка" FontWeight="Bold" />
                <ComboBox ItemsSource="{Binding KeyboardLayouts}" SelectedItem="{Binding SelectedKeyboardLayout}" MinWidth="0" />
              </StackPanel>
              <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,0">
                <TextBlock Text="Минут" FontWeight="Bold" />
                <NumericUpDown Value="{Binding DurationMinutes}" Minimum="1" Maximum="180" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" Margin="12,12,0,0">
                <TextBlock Text="Мин. знаков" FontWeight="Bold" />
                <NumericUpDown Value="{Binding MinimumCharacters}" Minimum="1" Maximum="100000" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Этапы урока" Classes="h2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
              <WrapPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="− Последний" Command="{Binding RemoveLastStepCommand}" Margin="0,0,8,0" />
                <Button Content="+ Добавить этап" Command="{Binding AddStepCommand}" Classes="accent" />
              </WrapPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LessonStepEditorViewModel">
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                    <StackPanel Spacing="10">
                      <TextBox Text="{Binding Title}" Watermark="Название этапа" FontWeight="Bold" />
                      <TextBox Text="{Binding Text}" Watermark="Текст для набора" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" />
                      <Grid ColumnDefinitions="*,*">
                        <NumericUpDown Value="{Binding TargetCpm}" Minimum="0" Maximum="2000" Watermark="Цель CPM" />
                        <NumericUpDown Grid.Column="1" Value="{Binding TargetAccuracy}" Minimum="0" Maximum="100" Watermark="Цель точности" Margin="12,0,0,0" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Сохранить урок" Command="{Binding CreateLessonCommand}" IsEnabled="{Binding !IsBusy}" Classes="primary" HorizontalAlignment="Stretch" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

      <Grid Grid.Row="1" IsVisible="{Binding ShowTypingStatistics}">
        <Border Classes="card">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding StatsReportTitle}" Classes="h2" />
              <TextBlock Text="Графики CPM и точности по урокам печати" Classes="muted" />
              <Border Classes="segmentBar" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="Группа" Command="{Binding ShowStatsGroupScopeCommand}" Classes="segment" Classes.active="{Binding ShowStatsForGroup}" />
                  <Button Content="Ученик" Command="{Binding ShowStatsStudentScopeCommand}" Classes="segment" Classes.active="{Binding ShowStatsForStudent}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" Margin="0,16,0,0">
              <StackPanel Spacing="6" IsVisible="{Binding ShowStatsForGroup}" Margin="0,0,12,0">
                <TextBlock Text="Группа" FontWeight="SemiBold" FontSize="12" Classes="muted" />
                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding ShowStatsForStudent}" Margin="0,0,12,0">
                <TextBlock Text="Ученик" FontWeight="SemiBold" FontSize="12" Classes="muted" />
                <ComboBox ItemsSource="{Binding FilteredStudents}" SelectedItem="{Binding SelectedStudent}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,12,0">
                <TextBlock Text="Урок" FontWeight="SemiBold" FontSize="12" Classes="muted" />
                <ComboBox ItemsSource="{Binding StatsLessonFilters}" SelectedItem="{Binding SelectedStatsLesson}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <Button Grid.Column="2" Content="Показать" Command="{Binding RefreshTypingChartsCommand}" Classes="primary" VerticalAlignment="Bottom" MinWidth="120" />
            </Grid>

            <Border Grid.Row="2" Classes="subcard" Margin="0,16,0,0">
              <TextBlock Text="{Binding StatsSummaryText}" TextWrapping="Wrap" LineHeight="22" />
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*,*" Margin="0,18,0,0" IsVisible="{Binding HasStatsBars}">
              <Border Classes="subcard" Margin="0,0,8,0">
                <StackPanel Spacing="10">
                  <TextBlock Text="Средний CPM по урокам" FontWeight="Bold" />
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding StatsCpmBars}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom" Height="180" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChartBarViewModel">
                          <StackPanel Width="72" Spacing="6" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding ValueLabel}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TealBrush}" />
                            <Border Height="{Binding Height}" CornerRadius="8,8,4,4" Background="{DynamicResource TealBrush}" HorizontalAlignment="Stretch" MinHeight="8" />
                            <TextBlock Text="{Binding Label}" FontSize="10" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="subcard" Margin="8,0,0,0">
                <StackPanel Spacing="10">
                  <TextBlock Text="Средняя точность по урокам" FontWeight="Bold" />
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding StatsAccuracyBars}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom" Height="180" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChartBarViewModel">
                          <StackPanel Width="72" Spacing="6" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding ValueLabel}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" />
                            <Border Height="{Binding Height}" CornerRadius="8,8,4,4" Background="{DynamicResource SuccessBrush}" HorizontalAlignment="Stretch" MinHeight="8" />
                            <TextBlock Text="{Binding Label}" FontSize="10" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="3" Classes="subcard" Margin="0,18,0,0" IsVisible="{Binding HasNoStatsBars}">
              <TextBlock Text="Графиков пока нет — завершите уроки печати или снимите фильтр." Classes="muted" TextWrapping="Wrap" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
      </TabItem>
      <TabItem Header="Ученики и группы">
        <Grid Margin="24,24" ColumnDefinitions="*,Auto">
          <Border Classes="card">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel>
                <TextBlock Text="Группы" Classes="h2" />
                <TextBlock Text="Выберите группу — справа появится меню настроек" Classes="muted" Margin="0,4,0,14" />
              </StackPanel>
              <ScrollViewer Grid.Row="1">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding HasGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GroupCardViewModel">
                        <Button Command="{Binding #TutorRoot.DataContext.SelectGroupCommand}"
                                CommandParameter="{Binding}"
                                Classes="listCard">
                          <Border Classes="listCardInner" Classes.selected="{Binding IsSelected}">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border IsVisible="{Binding HasNoGroups}" Classes="subcard">
                    <TextBlock Text="Групп пока нет — создайте первую внизу." Classes="muted" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Spacing="8" Margin="0,14,0,0">
                <Button Content="Новая группа" Command="{Binding ToggleCreateGroupFormCommand}" Classes="ghost" HorizontalAlignment="Stretch" />
                <StackPanel Spacing="8" IsVisible="{Binding ShowCreateGroupForm}">
                  <TextBox Text="{Binding GroupName}" Watermark="Название группы" />
                  <TextBox Text="{Binding GroupModule}" Watermark="Текущий модуль" />
                  <TextBox Text="{Binding GroupTopics}" Watermark="Темы" />
                  <Button Content="Создать группу" Command="{Binding CreateGroupCommand}" Classes="accent" HorizontalAlignment="Stretch" />
                </StackPanel>
                <Button Content="Удалить выбранную группу" Command="{Binding DeleteGroupCommand}" Classes="danger" HorizontalAlignment="Stretch" IsVisible="{Binding ShowGroupsWorkspace}" />
              </StackPanel>
            </Grid>
          </Border>

          <SplitView Grid.Column="1"
                     Width="{Binding GroupsWorkspaceWidth}"
                     Margin="18,0,0,0"
                     DisplayMode="Inline"
                     PanePlacement="Right"
                     OpenPaneLength="564"
                     CompactPaneLength="0"
                     IsPaneOpen="{Binding IsGroupWorkspaceOpen}"
                     IsVisible="{Binding ShowGroupsWorkspace}">
            <Border Classes="card">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding SelectedGroup.Name}" Classes="h2" TextWrapping="Wrap" />
                    <TextBlock Text="Что настроить?" Classes="muted" FontSize="12" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="✕" Classes="ghost" MinHeight="32" Width="36" Padding="0"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                          Command="{Binding CloseGroupChoiceCommand}" />
                </Grid>
                <StackPanel Grid.Row="1">
                  <Button Command="{Binding OpenGroupModulesWorkspaceCommand}" Classes="choiceCard" Classes.on="{Binding ShowGroupModulesWorkspace}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Модули" FontWeight="Bold" FontSize="16" />
                      <TextBlock Text="Программа, даты и текущий модуль по календарю" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding OpenGroupStudentsWorkspaceCommand}" Classes="choiceCard" Classes.on="{Binding ShowGroupStudentsWorkspace}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Ученики" FontWeight="Bold" FontSize="16" />
                      <TextBlock Text="Список группы, карточки и кибероны" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
            <SplitView.Pane>
              <Border Classes="card" Margin="18,0,0,0">
                <Grid>
                  <Grid RowDefinitions="Auto,*" IsVisible="{Binding ShowGroupModulesWorkspace}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Модули группы" Classes="h2" />
                        <TextBlock Text="{Binding CurrentModuleSchedule}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Назад" Classes="ghost" MinHeight="32" Padding="12,4"
                              Command="{Binding CloseGroupWorkspaceCommand}" VerticalAlignment="Top" />
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                      <ItemsControl ItemsSource="{Binding SelectedGroupModules}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProgramModuleCardViewModel">
                            <Border Classes="subcard" Margin="0,0,0,8" Padding="10,8" Classes.selected="{Binding IsCurrent}">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Dates}" Classes="muted" FontSize="12" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>

                  <Grid ColumnDefinitions="*,*" IsVisible="{Binding ShowGroupStudentsWorkspace}">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,0,12,0">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <StackPanel>
                          <TextBlock Text="Ученики группы" Classes="h2" />
                          <TextBlock Text="Клик — редактирование карточки" Classes="muted" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Назад" Classes="ghost" MinHeight="32" Padding="12,4"
                                Command="{Binding CloseGroupWorkspaceCommand}" VerticalAlignment="Top" />
                      </Grid>
                      <Button Grid.Row="1" Content="+ Добавить ученика" Command="{Binding BeginCreateStudentCommand}" Classes="primary" HorizontalAlignment="Stretch" Margin="0,0,0,12" />
                      <Grid Grid.Row="2">
                        <ScrollViewer IsVisible="{Binding HasFilteredStudents}">
                          <ItemsControl ItemsSource="{Binding FilteredStudents}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:StudentCardViewModel">
                                <Button Command="{Binding #TutorRoot.DataContext.BeginEditStudentCommand}"
                                        CommandParameter="{Binding}"
                                        Classes="listCard">
                                  <Border Classes="listCardInner" Classes.selected="{Binding IsSelected}">
                                    <Grid ColumnDefinitions="*,Auto">
                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                        <WrapPanel Orientation="Horizontal">
                                          <Border Classes="pillOnline" IsVisible="{Binding IsOnline}" Margin="0,0,8,4">
                                            <TextBlock Text="онлайн" Foreground="{DynamicResource TealBrush}" FontSize="11" FontWeight="Bold" />
                                          </Border>
                                          <Border Classes="pill" IsVisible="{Binding IsOffline}" Margin="0,0,8,4">
                                            <TextBlock Text="оффлайн" Classes="muted" FontSize="11" FontWeight="Bold" />
                                          </Border>
                                          <Border Classes="pill" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding BatteryLabel, StringFormat=⚡ {0}}" FontSize="11" FontWeight="Bold" />
                                          </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Progress}" Classes="muted" FontSize="12" />
                                      </StackPanel>
                                      <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Balance}" FontWeight="Bold" FontSize="12" />
                                      </Border>
                                    </Grid>
                                  </Border>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                        <Border IsVisible="{Binding HasNoFilteredStudents}" Classes="subcard" VerticalAlignment="Top">
                          <TextBlock Text="В этой группе пока нет учеников." Classes="muted" TextWrapping="Wrap" />
                        </Border>
                      </Grid>
                    </Grid>
                    <ScrollViewer Grid.Column="1">
                      <StackPanel Spacing="10">
                        <TextBlock Text="{Binding StudentFormTitle}" Classes="h2" />
                        <TextBlock Text="ФИО, возраст, ДР, уровень и кибероны" Classes="muted" Margin="0,0,0,6" />
                        <TextBox Text="{Binding StudentLastName}" Watermark="Фамилия" />
                        <TextBox Text="{Binding StudentFirstName}" Watermark="Имя" />
                        <NumericUpDown Value="{Binding StudentAge}" Minimum="5" Maximum="100" Watermark="Возраст" />
                        <TextBox Text="{Binding StudentBirthdayText}" Watermark="ДР: ДД.ММ.ГГГГ" />
                        <Grid ColumnDefinitions="*,*">
                          <StackPanel Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="Уровень" FontSize="12" Classes="muted" />
                            <NumericUpDown Value="{Binding StudentLevel}" Minimum="1" Maximum="100" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                            <TextBlock Text="Кибероны" FontSize="12" Classes="muted" />
                            <NumericUpDown Value="{Binding StudentKiberons}" Minimum="0" Maximum="100000" />
                          </StackPanel>
                        </Grid>
                        <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" PlaceholderText="Группа" />
                        <TextBox Text="{Binding StudentComment}" Watermark="Комментарий тьютора" AcceptsReturn="True" MinHeight="70" />
                        <Button Content="{Binding StudentFormActionLabel}" Command="{Binding SaveStudentCommand}" Classes="primary" HorizontalAlignment="Stretch" />
                        <Button Content="Новая карточка" Command="{Binding BeginCreateStudentCommand}" Classes="ghost" HorizontalAlignment="Stretch" />
                        <Button Content="Удалить ученика" Command="{Binding DeleteStudentCommand}" Classes="danger" HorizontalAlignment="Stretch" IsVisible="{Binding IsEditingStudent}" />
                        <Border Classes="subcard" Margin="0,4,0,0">
                          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" />
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </Grid>
              </Border>
            </SplitView.Pane>
          </SplitView>
        </Grid>
      </TabItem>
      <TabItem Header="Награды и магазин">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="0" />
            <ColumnDefinition Width="*" MinWidth="0" />
            <ColumnDefinition Width="*" MinWidth="0" />
          </Grid.ColumnDefinitions>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="Ученик" Classes="h2" />
              <TextBlock Text="Выберите получателя награды или покупки" Classes="muted" />
              <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" />
              <Button Content="+10 киберонов" Command="{Binding AddKiberonsCommand}" Classes="accent" />
              <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Margin="18,0">
            <StackPanel Spacing="10">
              <TextBlock Text="Достижения" Classes="h2" />
              <ComboBox ItemsSource="{Binding Achievements}" SelectedItem="{Binding SelectedAchievement}" />
              <Button Content="Выдать выбранное" Command="{Binding AwardAchievementCommand}" Classes="primary" />
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                <StackPanel Spacing="8">
                  <TextBlock Text="Новое достижение" FontWeight="Bold" />
                  <TextBox Text="{Binding AchievementCode}" Watermark="Код: first_win" />
                  <TextBox Text="{Binding AchievementName}" Watermark="Название" />
                  <Grid ColumnDefinitions="*,*">
                    <NumericUpDown Value="{Binding AchievementXp}" Minimum="0" Maximum="10000" Watermark="XP" />
                    <NumericUpDown Grid.Column="1" Value="{Binding AchievementKiberons}" Minimum="0" Maximum="10000" Watermark="Кибероны" Margin="8,0,0,0" />
                  </Grid>
                  <Button Content="Создать достижение" Command="{Binding CreateAchievementCommand}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="Магазин" Classes="h2" />
              <ComboBox ItemsSource="{Binding StoreItems}" SelectedItem="{Binding SelectedStoreItem}" />
              <Button Content="Оформить покупку" Command="{Binding PurchaseCommand}" Classes="primary" />
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                <StackPanel Spacing="8">
                  <TextBlock Text="Новый товар" FontWeight="Bold" />
                  <TextBox Text="{Binding StoreSku}" Watermark="Артикул" />
                  <TextBox Text="{Binding StoreItemName}" Watermark="Название" />
                  <Grid ColumnDefinitions="*,*">
                    <NumericUpDown Value="{Binding StorePrice}" Minimum="0" Maximum="100000" Watermark="Цена" />
                    <NumericUpDown Grid.Column="1" Value="{Binding StoreStock}" Minimum="0" Maximum="10000" Watermark="Остаток" Margin="8,0,0,0" />
                  </Grid>
                  <Button Content="Добавить товар" Command="{Binding CreateStoreItemCommand}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Сохранения и версии">
        <Grid ColumnDefinitions="0.8*,1.7*" Margin="32,32">
          <Border Classes="card">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel>
                <TextBlock Text="Запросы подтверждения" Classes="h2" />
                <TextBlock Text="Если версии сохранений разошлись — обновить с ПК ученика или восстановить копию тьютора" Classes="muted" Margin="0,4,0,12" TextWrapping="Wrap" />
              </StackPanel>
              <ListBox Grid.Row="1" ItemsSource="{Binding SyncApprovals}" SelectedItem="{Binding SelectedSyncApproval}" />
              <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,12,0,0">
                <Button Content="Восстановить" Command="{Binding RejectSyncCommand}" />
                <Button Grid.Column="1" Content="Обновить" Command="{Binding ApproveSyncCommand}" Classes="primary" Margin="8,0,0,0" />
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="card" Margin="18,0,0,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <StackPanel>
                <TextBlock Text="Файлы учеников" Classes="h2" />
                <TextBlock Text="Папка группы → ученик → модуль. Выберите ПК, файл и точку восстановления" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,12">
                <ComboBox ItemsSource="{Binding SyncClients}" SelectedItem="{Binding SelectedSyncClient}" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Загрузить файлы" Command="{Binding LoadSyncedFilesCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,*">
                <StackPanel Margin="0,0,8,0" Spacing="8">
                  <TextBlock Text="Файлы на сервере" FontWeight="Bold" />
                  <ListBox ItemsSource="{Binding SyncedFiles}" SelectedItem="{Binding SelectedSyncedFile}" MinHeight="280" />
                  <Button Content="Показать версии" Command="{Binding LoadVersionsCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="8">
                  <TextBlock Text="История — до 30 снимков" FontWeight="Bold" />
                  <ListBox ItemsSource="{Binding FileVersions}" SelectedItem="{Binding SelectedFileVersion}" MinHeight="280" />
                  <Button Content="Восстановить выбранную версию" Command="{Binding RestoreVersionCommand}" Classes="accent" />
                </StackPanel>
              </Grid>
              <Border Grid.Row="3" Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
              </Border>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Экраны">
        <Grid RowDefinitions="Auto,*" Margin="32,32">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
            <StackPanel>
              <TextBlock Text="{Binding ScreenPreviews.Count, StringFormat={}{0} экранов}" Classes="h2" />
              <TextBlock Text="Последние снимки из локальной сети" Classes="muted" FontSize="13" Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Обновить сетку" Command="{Binding RefreshScreenGridCommand}" />
          </Grid>
          <Grid Grid.Row="1">
            <ScrollViewer IsVisible="{Binding HasScreenPreviews}">
              <ItemsControl ItemsSource="{Binding ScreenPreviews}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ScreenPreviewCardViewModel">
                    <Button Classes="listCard" Width="246" Margin="0,0,20,24">
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                          <MenuItem Header="{Binding Title}" IsEnabled="False" />
                          <MenuItem Header="Заблокировать экран" Command="{Binding #TutorRoot.DataContext.PcLockCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Разблокировать экран" Command="{Binding #TutorRoot.DataContext.PcUnlockCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Watchdog вкл" Command="{Binding #TutorRoot.DataContext.PcWatchdogOnCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Watchdog выкл" Command="{Binding #TutorRoot.DataContext.PcWatchdogOffCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Фокус вкл" Command="{Binding #TutorRoot.DataContext.PcFocusOnCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Фокус выкл" Command="{Binding #TutorRoot.DataContext.PcFocusOffCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Синхронизировать" Command="{Binding #TutorRoot.DataContext.PcSyncCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Отправить сообщение" Command="{Binding #TutorRoot.DataContext.PcMessageCommand}" CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Header="Папка ученика на сервере" Command="{Binding #TutorRoot.DataContext.OpenPcFolderCommand}" CommandParameter="{Binding}" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <Border Classes="card" Width="246" Height="168" Padding="10">
                        <StackPanel Spacing="7">
                          <Grid Height="108" Background="{DynamicResource PreviewPanelBrush}">
                            <TextBlock Text="Ожидаем первый снимок…" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                          </Grid>
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="⋯" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" />
                          </Grid>
                          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TealBrush}" FontSize="11" />
                        </StackPanel>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border IsVisible="{Binding HasNoScreenPreviews}" Classes="card" HorizontalAlignment="Stretch" VerticalAlignment="Top">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource MintBrush}">
                  <TextBlock Text="▦" Foreground="{DynamicResource TealBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="6">
                  <TextBlock Text="Нет подключённых экранов" FontWeight="Bold" FontSize="16" />
                  <TextBlock Text="Запустите Student на компьютерах класса, затем нажмите «Обновить сетку»." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Пульт класса">
        <ScrollViewer Margin="28,28">
          <StackPanel Spacing="18" MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
              <TextBlock Text="Карточки управления" Classes="h2" />
              <TextBlock Text="Нажмите карточку, чтобы включить или выключить режим. Состояние подсвечивается." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>

            <UniformGrid Columns="3">
              <Button Command="{Binding ToggleScreensLockCommand}" Classes="toggleCard" Classes.on="{Binding IsScreensLocked}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <Border Classes="toggleIcon">
                      <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top" IsVisible="{Binding IsScreensLocked}">
                      <TextBlock Text="ВКЛ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TealBrush}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="Экраны" FontWeight="Bold" FontSize="16" />
                  <TextBlock Text="{Binding ScreensLockLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Button>

              <Button Command="{Binding ToggleFocusModeCommand}" Classes="toggleCard" Classes.on="{Binding IsFocusModeOn}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <Border Classes="toggleIcon">
                      <TextBlock Text="◎" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TealBrush}" />
                    </Border>
                    <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top" IsVisible="{Binding IsFocusModeOn}">
                      <TextBlock Text="ВКЛ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TealBrush}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="Режим фокуса" FontWeight="Bold" FontSize="16" />
                  <TextBlock Text="{Binding FocusModeLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Button>

              <Button Command="{Binding ToggleWatchdogCommand}" Classes="toggleCard" Classes.on="{Binding IsWatchdogOn}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <Border Classes="toggleIcon">
                      <TextBlock Text="🐕" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top" IsVisible="{Binding IsWatchdogOn}">
                      <TextBlock Text="ВКЛ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TealBrush}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="Watchdog" FontWeight="Bold" FontSize="16" />
                  <TextBlock Text="{Binding WatchdogLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Button>

              <Button Command="{Binding ToggleVpnCommand}" Classes="toggleCard" Classes.on="{Binding IsVpnOn}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <Border Classes="toggleIcon">
                      <TextBlock Text="🛡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top" IsVisible="{Binding IsVpnOn}">
                      <TextBlock Text="ВКЛ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TealBrush}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="VPN" FontWeight="Bold" FontSize="16" />
                  <TextBlock Text="{Binding VpnToggleLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Button>

              <Button Command="{Binding SyncAllNowCommand}" Classes="toggleCard">
                <StackPanel Spacing="10">
                  <Border Classes="toggleIcon">
                    <TextBlock Text="↻" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TealBrush}" />
                  </Border>
                  <TextBlock Text="Синхронизация" FontWeight="Bold" FontSize="16" />
                  <TextBlock Text="Разовая команда: синхронизировать файлы на всех ПК сейчас." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Button>

              <Button Command="{Binding NavigateCommand}" CommandParameter="9" Classes="toggleCard">
                <StackPanel Spacing="10">
                  <Border Classes="toggleIcon">
                    <TextBlock Text="?" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TealBrush}" />
                  </Border>
                  <TextBlock Text="Викторины" FontWeight="Bold" FontSize="16" />
                  <TextBlock Text="Отдельный редактор вопросов, настройки и экспорт JSON." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </UniformGrid>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Сообщение классу" Classes="h2" />
                <TextBox Text="{Binding ClassroomMessage}" Watermark="Инструкция или объявление ученикам" AcceptsReturn="True" MinHeight="88" TextWrapping="Wrap" />
                <Button Content="Отправить всем" Command="{Binding SendMessageAllCommand}" Classes="primary" HorizontalAlignment="Left" MinWidth="180" />
              </StackPanel>
            </Border>

            <Border Classes="subcard">
              <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Живой урок">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,24">
          <Border Classes="card">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Живой урок печати" Classes="h2" />
                  <TextBlock Text="{Binding LiveLessonState}" Classes="muted" FontSize="14" Margin="0,6,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Classes="status" VerticalAlignment="Top">
                  <TextBlock Text="{Binding ConnectedClientLabel}" Foreground="{DynamicResource TealBrush}" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                </Border>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="0.7*,1.8*" Margin="0,20,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Text="Название урока" FontWeight="Bold" />
                  <TextBox Text="{Binding LiveLessonName}" Watermark="Например, Циклы Python" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" Margin="14,0,0,0">
                  <TextBlock Text="Текст для учеников" FontWeight="Bold" />
                  <TextBox Text="{Binding LiveLessonText}" Watermark="Введите текст упражнения" />
                </StackPanel>
              </Grid>
              <Border Grid.Row="2" Background="{DynamicResource PreviewPanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,18,0,0" Padding="28,22" MinHeight="120">
                <StackPanel>
                  <TextBlock Text="{Binding LiveLessonText}" FontFamily="Cascadia Mono, Consolas" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                  <TextBlock Text="Этот текст увидят ученики после запуска" Classes="muted" FontSize="13" Margin="0,18,0,0" />
                </StackPanel>
              </Border>
              <TextBlock Grid.Row="3" Text="Средние показатели появятся во время урока" FontWeight="Bold" FontSize="15" Margin="0,24,0,0" />
              <Grid Grid.Row="4" ColumnDefinitions="*,*,*" Margin="0,16,0,20">
                <TextBlock Text="— CPM" Foreground="{DynamicResource TealBrush}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="— точность" Foreground="{DynamicResource SuccessBrush}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="8,0" />
                <TextBlock Grid.Column="2" Text="— знаков" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid Grid.Row="5" ColumnDefinitions="*,*">
                <Button Content="Запустить для всего класса" Command="{Binding StartLiveLessonCommand}" Classes="primary" />
                <Button Grid.Column="1" Content="Завершить урок" Command="{Binding FinishLiveLessonCommand}" Classes="danger" Margin="12,0,0,0" />
              </Grid>
              <Border Grid.Row="6" Classes="subcard" Margin="0,18,0,0" IsVisible="{Binding HasLessonResultsNotification}">
                <StackPanel Spacing="8">
                  <TextBlock Text="Уведомление: итоги урока" FontWeight="Bold" />
                  <TextBlock Text="{Binding LessonResultsSummary}" Classes="muted" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Winners}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WinnerCardViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                          <TextBlock Text="{Binding Place}" FontWeight="Bold" />
                          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TealBrush}" />
                          <TextBlock Text="{Binding Details}" Classes="muted" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="К классу сейчас" Command="{Binding NavigateCommand}" CommandParameter="0" Classes="ghost" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Итоги урока">
        <Border Classes="card" Margin="36,40" MaxWidth="720" HorizontalAlignment="Left">
          <StackPanel Spacing="14">
            <TextBlock Text="Итоги урока перенесены" Classes="h2" />
            <TextBlock Text="После завершения живого урока награды появляются в уведомлениях на экране «Класс сейчас»." Classes="muted" TextWrapping="Wrap" />
            <Button Content="Открыть класс сейчас" Command="{Binding NavigateCommand}" CommandParameter="0" Classes="primary" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Header="Викторины">
        <Grid Margin="24,24" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="4" Margin="0,0,12,0">
              <TextBlock Text="{Binding QuizTitle}" Classes="h2" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding QuizStatus}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
              <Border Classes="segmentBar" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="Вопросы" Command="{Binding ShowQuizQuestionsPaneCommand}" Classes="segment" Classes.active="{Binding ShowQuizQuestions}" />
                  <Button Content="Настройки" Command="{Binding ShowQuizSettingsPaneCommand}" Classes="segment" Classes.active="{Binding ShowQuizSettings}" />
                </StackPanel>
              </Border>
              <Button Content="Экспорт JSON" Command="{Binding ExportQuizCommand}" Classes="ghost" Margin="0,0,8,8" />
              <Button Content="Импорт JSON" Command="{Binding ImportQuizCommand}" Classes="ghost" Margin="0,0,8,8" />
              <Button Content="Сохранить" Command="{Binding SaveQuizDraftCommand}" Classes="primary" Margin="0,0,8,8" />
              <Button Content="Запустить вопрос" Command="{Binding StartQuizCommand}" Classes="accent" Margin="0,0,0,8" />
            </WrapPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="200,*" IsVisible="{Binding ShowQuizQuestions}">
            <Border Classes="card" Padding="14">
              <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Text="Вопросы" FontWeight="Bold" Margin="0,0,0,10" />
                <ScrollViewer Grid.Row="1">
                  <ItemsControl ItemsSource="{Binding QuizQuestions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:QuizQuestionEditorViewModel">
                        <Button Command="{Binding #TutorRoot.DataContext.SelectQuizQuestionCommand}"
                                CommandParameter="{Binding}"
                                Classes="listCard">
                          <Border Classes="listCardInner" Classes.selected="{Binding IsSelected}">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding NumberLabel}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TealBrush}" />
                              <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" FontSize="13" />
                            </StackPanel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
                  <Button Content="+ Добавить вопрос" Command="{Binding AddQuizQuestionCommand}" Classes="primary" HorizontalAlignment="Stretch" />
                  <Button Content="Удалить вопрос" Command="{Binding RemoveQuizQuestionCommand}" Classes="danger" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" Margin="16,0,0,0" IsVisible="{Binding HasSelectedQuizQuestion}">
              <ScrollViewer>
                <StackPanel Spacing="14">
                  <TextBlock Text="Текст вопроса" FontWeight="Bold" />
                  <TextBox Text="{Binding SelectedQuizQuestion.Text}" Watermark="Введите вопрос" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />

                  <TextBlock Text="Медиа (необязательно)" FontWeight="Bold" />
                  <Border Classes="subcard">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Text="{Binding SelectedQuizQuestion.MediaLabel}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Загрузить…" Command="{Binding PickQuizMediaCommand}" Classes="ghost" Margin="10,0,0,0" />
                      <Button Grid.Row="1" Grid.ColumnSpan="2" Content="Убрать медиа" Command="{Binding ClearQuizMediaCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Classes="ghost" />
                    </Grid>
                  </Border>

                  <TextBlock Text="Варианты ответа · отметьте правильный" FontWeight="Bold" />
                  <ItemsControl ItemsSource="{Binding SelectedQuizQuestion.Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:QuizOptionEditorViewModel">
                        <Border Classes="subcard" Margin="0,0,0,8" Classes.selected="{Binding IsCorrect}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource MintBrush}" Margin="0,0,10,0">
                              <TextBlock Text="{Binding Letter}" FontWeight="Bold" Foreground="{DynamicResource TealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Text="{Binding Text}" Watermark="Вариант ответа" />
                            <Button Grid.Column="2" Content="✓" Command="{Binding MarkCorrectCommand}" Width="40" Margin="8,0,0,0"
                                    Classes.primary="{Binding IsCorrect}" Classes.ghost="{Binding IsIncorrect}" ToolTip.Tip="Правильный ответ" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="+ Вариант" Command="{Binding AddQuizOptionCommand}" Classes="ghost" HorizontalAlignment="Left" />
                </StackPanel>
              </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Classes="card" Margin="16,0,0,0" IsVisible="{Binding HasNoSelectedQuizQuestion}">
              <TextBlock Text="Добавьте вопрос слева или выберите существующий." Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </Grid>

          <Border Grid.Row="1" Classes="card" IsVisible="{Binding ShowQuizSettings}" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="14">
              <TextBlock Text="Параметры викторины" Classes="h2" />
              <TextBlock Text="Как в myQuiz: название, время на вопрос, XP, перемешивание и подсказка после ответа." Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="Название" FontWeight="Bold" />
              <TextBox Text="{Binding QuizTitle}" Watermark="Название викторины" />
              <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                <StackPanel Spacing="6" Margin="0,0,10,0">
                  <TextBlock Text="Секунд на вопрос" FontWeight="Bold" />
                  <NumericUpDown Value="{Binding QuizTimePerQuestion}" Minimum="5" Maximum="300" />
                </StackPanel>
                <StackPanel Spacing="6" Margin="10,0,0,0">
                  <TextBlock Text="XP за правильный ответ" FontWeight="Bold" />
                  <NumericUpDown Value="{Binding QuizXpReward}" Minimum="0" Maximum="1000" />
                </StackPanel>
              </Grid>
              <CheckBox Content="Перемешивать варианты при запуске" IsChecked="{Binding QuizShuffleAnswers}" />
              <CheckBox Content="Показывать ученику результат ответа" IsChecked="{Binding QuizShowFeedback}" />
              <Button Content="Новая викторина" Command="{Binding NewQuizCommand}" Classes="ghost" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Статистика группы">
        <Border Classes="card" Margin="36,40"><Grid RowDefinitions="Auto,300,Auto"><StackPanel><TextBlock Text="Динамика класса" FontSize="22" FontWeight="Bold"/><TextBlock Text="Средний CPM и точность по завершённым сессиям" Classes="muted" Margin="0,8,0,0"/></StackPanel><Border Grid.Row="1" Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Margin="32,58"><Grid ColumnDefinitions="*,*,*,*,*,*,*" VerticalAlignment="Bottom"><Border Background="{DynamicResource TealBrush}" CornerRadius="6" Width="48" Height="55" VerticalAlignment="Bottom"/><Border Grid.Column="1" Background="{DynamicResource TealBrush}" CornerRadius="6" Width="48" Height="75" VerticalAlignment="Bottom"/><Border Grid.Column="2" Background="{DynamicResource TealBrush}" CornerRadius="6" Width="48" Height="88" VerticalAlignment="Bottom"/><Border Grid.Column="3" Background="{DynamicResource TealBrush}" CornerRadius="6" Width="48" Height="114" VerticalAlignment="Bottom"/><Border Grid.Column="4" Background="{DynamicResource TealBrush}" CornerRadius="6" Width="48" Height="139" VerticalAlignment="Bottom"/><Border Grid.Column="5" Background="{DynamicResource TealBrush}" CornerRadius="6" Width="48" Height="158" VerticalAlignment="Bottom"/><Border Grid.Column="6" Background="{DynamicResource TealBrush}" CornerRadius="6" Width="48" Height="183" VerticalAlignment="Bottom"/></Grid></Border><Grid Grid.Row="2" ColumnDefinitions="220,220,*" Margin="52,0"><StackPanel><TextBlock Text="Средний CPM" Classes="muted"/><TextBlock Text="44" Foreground="{DynamicResource TealBrush}" FontSize="28" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Точность" Classes="muted"/><TextBlock Text="91%" Foreground="{DynamicResource SuccessBrush}" FontSize="28" FontWeight="Bold"/></StackPanel></Grid></Grid></Border>
      </TabItem>
      <TabItem Header="Сервер и настройки">
        <ScrollViewer><Grid ColumnDefinitions="*,*" Margin="36,40">
          <StackPanel Spacing="18">
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Сервер локации" Classes="h2"/><TextBlock Text="Tutor принимает подключения только в локальной сети." Classes="muted"/><TextBlock Text="HTTP API" FontWeight="Bold"/><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Padding="14"><TextBlock Text="{Binding ServerAddress}"/></Border><TextBlock Text="Обнаружение Student" FontWeight="Bold"/><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Padding="14"><TextBlock Text="{Binding DiscoveryAddress}"/></Border><TextBlock Text="{Binding ConnectedClientLabel}" Foreground="{DynamicResource TealBrush}" FontWeight="Bold"/><TextBlock Text="{Binding VersionLabel}" Classes="muted"/></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Безопасность" Classes="h2"/><TextBlock Text="Токен класса не показывается в интерфейсе и передаётся Student только через локальное обнаружение." Classes="muted" TextWrapping="Wrap"/><TextBlock Text="Опасные файлы всегда требуют отдельного подтверждения во вкладке «Сохранения и версии»." Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"/></StackPanel></Border>
          </StackPanel>
          <Border Grid.Column="1" Classes="card" Margin="18,0,0,0">
            <StackPanel Spacing="14">
              <TextBlock Text="Настройки Tutor" Classes="h2"/>
              <TextBlock Text="Параметры текущей локации" Classes="muted"/>
              <TextBlock Text="Название локации" FontWeight="Bold"/>
              <TextBox Text="{Binding LocationName}"/>
              <TextBlock Text="Обновление экранов, секунд" FontWeight="Bold"/>
              <NumericUpDown Value="{Binding ScreenRefreshSeconds}" Minimum="5" Maximum="300"/>
              <TextBlock Text="Интервал синхронизации, секунд" FontWeight="Bold"/>
              <NumericUpDown Value="{Binding SyncIntervalSeconds}" Minimum="5" Maximum="600"/>
              <CheckBox Content="Автоматически принимать безопасные файлы" IsChecked="{Binding AutoApproveSafeFiles}"/>
              <CheckBox Content="Разрешить обновления Student" IsChecked="{Binding EnableStudentUpdates}"/>
              <CheckBox Content="Тёмная тема" IsChecked="{Binding IsDarkTheme}"/>
              <TextBlock Text="VPN · папка конфигов WireGuard" FontWeight="Bold"/>
              <TextBlock Text="Нужна один раз: на каждом ПК установите службу, затем укажите папку с .conf." Classes="muted" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding VpnConfigsFolder}" Watermark="Папка с VPN-конфигами" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Обзор…" Command="{Binding PickVpnConfigsFolderCommand}" Classes="ghost" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{Binding VpnDistributionStatus}" Classes="muted" TextWrapping="Wrap"/>
              <Button Content="Сохранить настройки" Command="{Binding SaveSettingsCommand}" Classes="primary" Margin="0,12,0,0"/>
              <Border Classes="subcard"><TextBlock Text="{Binding SettingsStatus}" TextWrapping="Wrap"/></Border>
            </StackPanel>
          </Border>
        </Grid></ScrollViewer>
      </TabItem>
      <TabItem Header="Модули и версии">
        <Grid ColumnDefinitions="220,*" Margin="24,24"><Border Classes="card"><Grid RowDefinitions="Auto,*,Auto"><TextBlock Text="Модули" FontSize="20" FontWeight="Bold"/><StackPanel Grid.Row="1" Spacing="18" Margin="0,30,0,0"><Border Background="{DynamicResource MintBrush}" CornerRadius="8" Height="44" Padding="16,0"><TextBlock Text="Python · активный" Foreground="{DynamicResource TealBrush}" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Border><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Height="44" Padding="16,0"><TextBlock Text="C# · архив" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Border><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Height="44" Padding="16,0"><TextBlock Text="Вёрстка · архив" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Border></StackPanel><Button Grid.Row="2" Content="Загрузить файлы" Command="{Binding LoadSyncedFilesCommand}" Classes="primary" HorizontalAlignment="Stretch"/></Grid></Border><Border Grid.Column="1" Classes="card" Margin="16,0,0,0"><Grid RowDefinitions="Auto,Auto,*"><TextBlock Text="Последние версии" FontSize="20" FontWeight="Bold"/><Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,22,0,18"><ComboBox ItemsSource="{Binding SyncClients}" SelectedItem="{Binding SelectedSyncClient}" MinWidth="0"/><Button Grid.Column="1" Content="Обновить" Command="{Binding LoadSyncedFilesCommand}" Margin="12,0,0,0"/></Grid><Grid Grid.Row="2" ColumnDefinitions="*,*"><ListBox ItemsSource="{Binding SyncedFiles}" SelectedItem="{Binding SelectedSyncedFile}" Margin="0,0,12,0"/><StackPanel Grid.Column="1" Spacing="10"><Button Content="Показать версии" Command="{Binding LoadVersionsCommand}" HorizontalAlignment="Stretch"/><ListBox ItemsSource="{Binding FileVersions}" SelectedItem="{Binding SelectedFileVersion}"/><Button Content="Восстановить" Command="{Binding RestoreVersionCommand}" Classes="primary" HorizontalAlignment="Stretch"/></StackPanel></Grid></Grid></Border></Grid>
      </TabItem>
      <TabItem Header="Сравнение">
        <Border Classes="card" Margin="24,24"><Grid RowDefinitions="Auto,*,Auto"><TextBlock Text="Сравнение версии" FontSize="22" FontWeight="Bold"/><Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,24,0,24"><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Padding="24" Margin="0,0,12,0"><StackPanel Spacing="18"><TextBlock Text="На компьютере" FontWeight="Bold"/><TextBlock Text="+ print(i)&#10;- print(j)" FontFamily="Consolas" Foreground="{DynamicResource SuccessBrush}" FontSize="15" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Padding="24" Margin="12,0,0,0"><StackPanel Spacing="18"><TextBlock Text="На сервере" FontWeight="Bold"/><TextBlock Text="+ print(i)&#10;- print(j)" FontFamily="Consolas" Foreground="{DynamicResource DangerBrush}" FontSize="15" TextWrapping="Wrap"/></StackPanel></Border></Grid><Button Grid.Row="2" Content="Восстановить эту версию" Command="{Binding RestoreVersionCommand}" Classes="danger" MaxWidth="300" HorizontalAlignment="Right"/></Grid></Border>
      </TabItem>
      <TabItem Header="Цели и каталог">
        <Border Classes="card" Margin="36,40"><Grid RowDefinitions="Auto,*"><StackPanel><TextBlock Text="Общий каталог" FontSize="22" FontWeight="Bold"/><TextBlock Text="Ближайшая выбранная цель показывается первой у ученика" Classes="muted" Margin="0,8,0,0"/></StackPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding StoreItems}" Margin="18,64,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:StoreItemCardViewModel"><Border Width="220" Margin="0,0,30,30"><StackPanel Spacing="12"><Border Background="{DynamicResource PreviewPanelBrush}" Height="110" CornerRadius="8"/><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding Details}" Foreground="{DynamicResource TealBrush}"/><Button Content="В каталоге" Classes="primary" Height="38"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
      </TabItem>
      <TabItem Header="Настройки Figma">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="*,*" Margin="24,24">
          <Border Classes="card">
            <StackPanel Spacing="20">
              <TextBlock Text="Основные параметры" FontSize="22" FontWeight="Bold"/>
              <TextBlock Text="Кибероны за обычный урок" FontWeight="Bold"/>
              <NumericUpDown Value="{Binding StorePrice}" Minimum="0" Maximum="1000"/>
              <TextBlock Text="Порог изменений для подтверждения" FontWeight="Bold"/>
              <TextBlock Text="Более 5 файлов" Classes="muted"/>
              <TextBlock Text="Минимум символов для рейтинга" FontWeight="Bold"/>
              <NumericUpDown Value="{Binding MinimumCharacters}" Minimum="1" Maximum="10000"/>
              <TextBlock Text="Интервал снимков экрана" FontWeight="Bold"/>
              <NumericUpDown Value="{Binding ScreenRefreshSeconds}" Minimum="5" Maximum="300"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Margin="22,0,0,0">
            <StackPanel Spacing="18">
              <TextBlock Text="Параметры локации" FontSize="22" FontWeight="Bold"/>
              <TextBlock Text="Локальное хранение журнала" FontWeight="Bold"/>
              <Border Background="{DynamicResource SurfaceSoftBrush}" Height="42" CornerRadius="8" Padding="16,0"><TextBlock Text="90 дней" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Имя тьютора для аудита" FontWeight="Bold"/>
              <TextBox Watermark="Не указано"/>
              <TextBlock Text="Тема интерфейса" FontWeight="Bold"/>
              <CheckBox Content="Тёмная тема" IsChecked="{Binding IsDarkTheme}"/>
              <TextBlock Text="Название локации" FontWeight="Bold"/>
              <TextBox Text="{Binding LocationName}"/>
              <TextBlock Text="VPN · папка конфигов WireGuard" FontWeight="Bold"/>
              <TextBlock Text="Нужна один раз: на каждом ПК установите службу, затем укажите папку с .conf." Classes="muted" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding VpnConfigsFolder}" Watermark="Папка с VPN-конфигами" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Обзор…" Command="{Binding PickVpnConfigsFolderCommand}" Classes="ghost" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{Binding VpnDistributionStatus}" Classes="muted" TextWrapping="Wrap"/>
              <Button Content="Сохранить настройки" Command="{Binding SaveSettingsCommand}" Classes="primary" Margin="0,22,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Достижения Figma">
        <Border Classes="card" Margin="24,24"><Grid RowDefinitions="Auto,*,Auto"><StackPanel><TextBlock Text="Награды урока печати" FontSize="22" FontWeight="Bold"/><TextBlock Text="Один ученик получает не более одной награды за сессию" Classes="muted" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="1" Spacing="16" Margin="0,24,0,0"><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" MinHeight="72" Padding="16"><Grid ColumnDefinitions="*,Auto,Auto"><StackPanel Margin="0,0,12,0"><TextBlock Text="Лучшая точность" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Повторное получение разрешено" Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="20 XP" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock Grid.Column="2" Text="Активно" Foreground="{DynamicResource TealBrush}" VerticalAlignment="Center"/></Grid></Border><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" MinHeight="72" Padding="16"><Grid ColumnDefinitions="*,Auto,Auto"><StackPanel Margin="0,0,12,0"><TextBlock Text="Самая высокая скорость" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Повторное получение разрешено" Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="20 XP" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock Grid.Column="2" Text="Активно" Foreground="{DynamicResource TealBrush}" VerticalAlignment="Center"/></Grid></Border><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" MinHeight="72" Padding="16"><Grid ColumnDefinitions="*,Auto,Auto"><StackPanel Margin="0,0,12,0"><TextBlock Text="Больше всего знаков" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Повторное получение разрешено" Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="20 XP" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock Grid.Column="2" Text="Активно" Foreground="{DynamicResource TealBrush}" VerticalAlignment="Center"/></Grid></Border><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Height="44" MaxWidth="300" HorizontalAlignment="Left" Padding="16,0"><TextBlock Text="Награда за обычный урок · 10 ₭" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Border></StackPanel><Button Grid.Row="2" Content="Сохранить правила" Command="{Binding SaveSettingsCommand}" Classes="primary" MaxWidth="300" HorizontalAlignment="Right"/></Grid></Border>
      </TabItem>
      <TabItem Header="Аудит">
        <Grid RowDefinitions="Auto,*" Margin="36,40">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding AuditCategories}" SelectedItem="{Binding SelectedAuditCategory}" MinWidth="140" MaxWidth="220" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding AuditSearch}" Watermark="Поиск по действию, ПК или пути" Margin="10,0" MinWidth="0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Обновить журнал" Command="{Binding RefreshAuditCommand}" Classes="primary" VerticalAlignment="Center" />
          </Grid>
          <Border Grid.Row="1" Classes="card">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding AuditEvents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AuditEventCardViewModel">
                    <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                      <Grid RowDefinitions="Auto,Auto">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                          <TextBlock Text="{Binding Time}" Classes="muted" Margin="0,0,12,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{DynamicResource TealBrush}" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding Action}" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Text="{Binding Target}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="4" Text="{Binding Result}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <TextBlock Text="{Binding Actor}" Classes="muted" Margin="0,0,12,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="{DynamicResource DangerTextBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Статистика">
        <Grid ColumnDefinitions="*,*" Margin="36,40">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="Статистика группы" Classes="h2" />
              <TextBlock Text="Сводка по оценкам, прогрессу и активности" Classes="muted" />
              <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" />
              <Button Content="Рассчитать по группе" Command="{Binding LoadGroupStatisticsCommand}" Classes="primary" />
              <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="12" Padding="20">
                <TextBlock Text="{Binding GroupStatisticsText}" FontSize="17" LineHeight="28" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Margin="18,0,0,0">
            <StackPanel Spacing="14">
              <TextBlock Text="Статистика ученика" Classes="h2" />
              <TextBlock Text="Персональные оценки, XP, достижения и покупки" Classes="muted" />
              <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" />
              <Button Content="Открыть карточку" Command="{Binding LoadStudentStatisticsCommand}" Classes="accent" />
              <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="12" Padding="20">
                <TextBlock Text="{Binding StudentStatisticsText}" FontSize="17" LineHeight="28" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
