<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kiberone.Tutor.ViewModels" x:Class="Kiberone.Tutor.Views.TutorVpnView" x:DataType="vm:MainViewModel">
 <ScrollViewer><Grid ColumnDefinitions="2*,*" Margin="24">
  <Border Classes="card" Margin="0,0,20,0" VerticalAlignment="Top"><StackPanel Spacing="24"><TextBlock Text="Подключение тьютора" Classes="h2"/><StackPanel Spacing="8"><TextBlock Text="Название подключения" FontWeight="SemiBold"/><TextBox Text="{Binding TutorTunnelName}" Watermark="Название подключения"/></StackPanel><TextBlock Text="{Binding TutorVpnStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/><Separator/><TextBlock Text="Доступ к локальной сети" Classes="h2"/><Button Content="Включить / выключить VPN" Command="{Binding ToggleTutorVpnCommand}" Classes="primary" IsEnabled="{Binding !TutorVpnBusy}"/></StackPanel></Border>
  <StackPanel Grid.Column="1" Spacing="20"><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Перед подключением" Classes="h2"/></StackPanel></Border><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="16" Padding="20"><StackPanel Spacing="14"><TextBlock Text="Состояние подключения" Classes="h2"/><TextBlock Text="{Binding TutorVpnStatus}" TextWrapping="Wrap"/><TextBlock Text="{Binding ConnectedClientLabel}" Classes="muted" TextWrapping="Wrap"/><Button Content="Обновить состояние" Command="{Binding CheckTutorVpnCommand}"/></StackPanel></Border></StackPanel>
 </Grid></ScrollViewer>
</UserControl>
