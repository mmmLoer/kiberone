<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kiberone.Tutor.App"
             xmlns:local="using:Kiberone.Tutor"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#F6F8F9" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#F1F5F6" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeaderBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InkBrush" Color="#13181D" />
                    <SolidColorBrush x:Key="BrandInkBrush" Color="#172126" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#6B7880" />
                    <SolidColorBrush x:Key="TealBrush" Color="#068F8A" />
                    <SolidColorBrush x:Key="TealHoverBrush" Color="#057B77" />
                    <SolidColorBrush x:Key="MintBrush" Color="#E0F5F2" />
                    <SolidColorBrush x:Key="SoftHoverBrush" Color="#EFF8F7" />
                    <SolidColorBrush x:Key="SoftSelectedBrush" Color="#E8F7F5" />
                    <SolidColorBrush x:Key="AmberBrush" Color="#FFB80D" />
                    <SolidColorBrush x:Key="AmberSoftBrush" Color="#FFF4CF" />
                    <SolidColorBrush x:Key="LineBrush" Color="#DCE5E8" />
                    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD7DB" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C93E45" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDEBEC" />
                    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#F2C7CA" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#A82F36" />
                    <SolidColorBrush x:Key="ServerBadgeBrush" Color="#FFF4CF" />
                    <SolidColorBrush x:Key="ServerBadgeBorderBrush" Color="#F4D675" />
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#DFE7E9" />
                    <SolidColorBrush x:Key="PreviewPanelBrush" Color="#F0F5F5" />
                    <SolidColorBrush x:Key="WinnerSoftBrush" Color="#FFF7DB" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#1F9E61" />
                    <SolidColorBrush x:Key="OfflineDotBrush" Color="#C5CED3" />
                    <SolidColorBrush x:Key="OnTealBrush" Color="#FFFFFF" />
                    <BoxShadows x:Key="CardShadow">0 6 18 0 #0D243239</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#0F1418" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A2228" />
                    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#232C33" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#151C21" />
                    <SolidColorBrush x:Key="HeaderBrush" Color="#151C21" />
                    <SolidColorBrush x:Key="InkBrush" Color="#E8EEF1" />
                    <SolidColorBrush x:Key="BrandInkBrush" Color="#F2F6F7" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#91A0A8" />
                    <SolidColorBrush x:Key="TealBrush" Color="#2BB5AE" />
                    <SolidColorBrush x:Key="TealHoverBrush" Color="#24A19B" />
                    <SolidColorBrush x:Key="MintBrush" Color="#1D3A39" />
                    <SolidColorBrush x:Key="SoftHoverBrush" Color="#243038" />
                    <SolidColorBrush x:Key="SoftSelectedBrush" Color="#1F3F3D" />
                    <SolidColorBrush x:Key="AmberBrush" Color="#FFB80D" />
                    <SolidColorBrush x:Key="AmberSoftBrush" Color="#3A3018" />
                    <SolidColorBrush x:Key="LineBrush" Color="#2E3941" />
                    <SolidColorBrush x:Key="InputBorderBrush" Color="#3A4750" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#E15B62" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1F23" />
                    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#6B343A" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#F0A3A8" />
                    <SolidColorBrush x:Key="ServerBadgeBrush" Color="#2E2918" />
                    <SolidColorBrush x:Key="ServerBadgeBorderBrush" Color="#6B5A28" />
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#2A343B" />
                    <SolidColorBrush x:Key="PreviewPanelBrush" Color="#232C33" />
                    <SolidColorBrush x:Key="WinnerSoftBrush" Color="#332B16" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#4AD08A" />
                    <SolidColorBrush x:Key="OfflineDotBrush" Color="#6A7A84" />
                    <SolidColorBrush x:Key="OnTealBrush" Color="#08201F" />
                    <BoxShadows x:Key="CardShadow">0 8 22 0 #66000000</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="LineHeight" Value="36" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LineHeight" Value="26" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="TextBlock.data">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.teal">
            <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        </Style>
        <Style Selector="Border.subcard">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.status">
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>
        <Style Selector="Border.headerBar">
            <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
        </Style>
        <Style Selector="Button:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.48" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource TealBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnTealBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="18,8" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TealBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource OnTealBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TealHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealHoverBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource OnTealBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TealHoverBrush}" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="Foreground" Value="#13181D" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="18,8" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F0AA00" />
            <Setter Property="BorderBrush" Value="#F0AA00" />
            <Setter Property="TextElement.Foreground" Value="#13181D" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#AD3037" />
            <Setter Property="BorderBrush" Value="#AD3037" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
        </Style>

        <Style Selector="Border.segmentBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="Button.segment">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.segment:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Button.segment.active">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.segment.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TealBrush}" />
        </Style>

        <Style Selector="Button.listCard">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.listCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.listCardInner">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Button.listCard:pointerover Border.listCardInner">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
        </Style>
        <Style Selector="Border.listCardInner:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
        </Style>
        <Style Selector="Border.listCardInner.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        </Style>
        <Style Selector="Border.notice">
            <Setter Property="Background" Value="{DynamicResource AmberSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Button.commandRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.choiceCard">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="108" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style Selector="Button.choiceCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Button.choiceCard.on">
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Button.choiceCard.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Button.toggleCard">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="118" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style Selector="Button.toggleCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Button.toggleCard.on">
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Button.toggleCard.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Border.toggleIcon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
        </Style>
        <Style Selector="Border.modeIcon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toggleCard.on Border.toggleIcon">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        </Style>

        <Style Selector="Border.subcard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="Background" Value="{DynamicResource SoftSelectedBrush}" />
        </Style>

        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource AmberSoftBrush}" />
        </Style>
        <Style Selector="Border.pillOnline">
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav.compact">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MintBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TealBrush}" />
        </Style>

        <Style Selector="TextBox, ComboBox, NumericUpDown">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="ComboBox /template/ ContentPresenter">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="NumericUpDown TextBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TextBox[AcceptsReturn=True]">
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="TextBox:pointerover, ComboBox:pointerover, NumericUpDown:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="TextBox:focus, ComboBox:focus, NumericUpDown:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0,0,0" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
            <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
            <Setter Property="CornerRadius" Value="100" />
        </Style>

        <Style Selector="Border.pill TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pillOnline TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.success">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>
        <Style Selector="SplitView">
            <Setter Property="CompactPaneLength" Value="0" />
        </Style>
        <Style Selector="TabControl.contentOnly">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabControl.contentOnly /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Application.Styles>
</Application>
