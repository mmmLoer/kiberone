<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kiberone.Tutor.App"
             xmlns:local="using:Kiberone.Tutor"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Fixed K1BER logo letter colors (R is theme-swapped for dark contrast). -->
            <SolidColorBrush x:Key="BrandKBrush" Color="#2BB5AE" />
            <SolidColorBrush x:Key="Brand1Brush" Color="#F5C518" />
            <SolidColorBrush x:Key="BrandBBrush" Color="#8B1E2D" />
            <SolidColorBrush x:Key="BrandEBrush" Color="#8A8F96" />

            <FontFamily x:Key="FontUi">Inter, Segoe UI</FontFamily>
            <FontFamily x:Key="FontData">Cascadia Mono, Consolas</FontFamily>
            <x:Double x:Key="TypeCaptionTight">11</x:Double>
            <x:Double x:Key="TypeCaption">12</x:Double>
            <x:Double x:Key="TypeEyebrow">11</x:Double>
            <x:Double x:Key="TypeBodySmall">13</x:Double>
            <x:Double x:Key="TypeBody">14</x:Double>
            <x:Double x:Key="TypeTitle">16</x:Double>
            <x:Double x:Key="TypeScreen">22</x:Double>
            <x:Double x:Key="TypeMetric">22</x:Double>
            <x:Double x:Key="Space1">4</x:Double>
            <x:Double x:Key="Space2">8</x:Double>
            <x:Double x:Key="Space3">12</x:Double>
            <x:Double x:Key="Space4">16</x:Double>
            <x:Double x:Key="Space5">24</x:Double>
            <x:Double x:Key="HitTarget">36</x:Double>
            <x:Double x:Key="HitTargetCompact">34</x:Double>
            <x:Double x:Key="HitTargetMin">32</x:Double>
            <Thickness x:Key="PadPage">16</Thickness>
            <Thickness x:Key="PadCard">16</Thickness>
            <Thickness x:Key="PadCardDense">12</Thickness>
            <Thickness x:Key="PadSubcard">12</Thickness>
            <Thickness x:Key="PadButton">16,8</Thickness>
            <Thickness x:Key="PadControl">12,0</Thickness>
            <Thickness x:Key="PadPill">12,4</Thickness>
            <CornerRadius x:Key="RadiusCard">12</CornerRadius>
            <CornerRadius x:Key="RadiusControl">8</CornerRadius>
            <CornerRadius x:Key="RadiusPill">100</CornerRadius>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrandRBrush" Color="#1A2A4A" />
                    <SolidColorBrush x:Key="CanvasBrush" Color="#F6F8F9" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#F1F5F6" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeaderBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InkBrush" Color="#13181D" />
                    <SolidColorBrush x:Key="BrandInkBrush" Color="#172126" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#6B7880" />
                    <SolidColorBrush x:Key="TealBrush" Color="#068F8A" />
                    <SolidColorBrush x:Key="TealHoverBrush" Color="#057B77" />
                    <SolidColorBrush x:Key="MintBrush" Color="#E0F5F2" />
                    <SolidColorBrush x:Key="SoftHoverBrush" Color="#EFF8F7" />
                    <SolidColorBrush x:Key="SoftSelectedBrush" Color="#E8F7F5" />
                    <SolidColorBrush x:Key="AmberBrush" Color="#FFB80D" />
                    <SolidColorBrush x:Key="AmberSoftBrush" Color="#FFF4CF" />
                    <SolidColorBrush x:Key="LineBrush" Color="#DCE5E8" />
                    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD7DB" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C93E45" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDEBEC" />
                    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#F2C7CA" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#A82F36" />
                    <SolidColorBrush x:Key="ServerBadgeBrush" Color="#FFF4CF" />
                    <SolidColorBrush x:Key="ServerBadgeBorderBrush" Color="#F4D675" />
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#DFE7E9" />
                    <SolidColorBrush x:Key="PreviewPanelBrush" Color="#F0F5F5" />
                    <SolidColorBrush x:Key="WinnerSoftBrush" Color="#FFF7DB" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#1F9E61" />
                    <SolidColorBrush x:Key="OfflineDotBrush" Color="#C5CED3" />
                    <SolidColorBrush x:Key="OnTealBrush" Color="#FFFFFF" />
                    <BoxShadows x:Key="CardShadow">0 6 18 0 #0D243239</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrandRBrush" Color="#7B96B8" />
                    <SolidColorBrush x:Key="CanvasBrush" Color="#0F1418" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A2228" />
                    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#232C33" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#151C21" />
                    <SolidColorBrush x:Key="HeaderBrush" Color="#151C21" />
                    <SolidColorBrush x:Key="InkBrush" Color="#E8EEF1" />
                    <SolidColorBrush x:Key="BrandInkBrush" Color="#F2F6F7" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#91A0A8" />
                    <SolidColorBrush x:Key="TealBrush" Color="#2BB5AE" />
                    <SolidColorBrush x:Key="TealHoverBrush" Color="#24A19B" />
                    <SolidColorBrush x:Key="MintBrush" Color="#1D3A39" />
                    <SolidColorBrush x:Key="SoftHoverBrush" Color="#243038" />
                    <SolidColorBrush x:Key="SoftSelectedBrush" Color="#1F3F3D" />
                    <SolidColorBrush x:Key="AmberBrush" Color="#FFB80D" />
                    <SolidColorBrush x:Key="AmberSoftBrush" Color="#3A3018" />
                    <SolidColorBrush x:Key="LineBrush" Color="#2E3941" />
                    <SolidColorBrush x:Key="InputBorderBrush" Color="#3A4750" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#E15B62" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1F23" />
                    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#6B343A" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#F0A3A8" />
                    <SolidColorBrush x:Key="ServerBadgeBrush" Color="#2E2918" />
                    <SolidColorBrush x:Key="ServerBadgeBorderBrush" Color="#6B5A28" />
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#2A343B" />
                    <SolidColorBrush x:Key="PreviewPanelBrush" Color="#232C33" />
                    <SolidColorBrush x:Key="WinnerSoftBrush" Color="#332B16" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#4AD08A" />
                    <SolidColorBrush x:Key="OfflineDotBrush" Color="#6A7A84" />
                    <SolidColorBrush x:Key="OnTealBrush" Color="#08201F" />
                    <BoxShadows x:Key="CardShadow">0 8 22 0 #66000000</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="{StaticResource TypeBody}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="{StaticResource TypeBody}" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="{StaticResource TypeScreen}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="LineHeight" Value="28" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="{StaticResource TypeTitle}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
        <Style Selector="TextBlock.screen">
            <Setter Property="FontSize" Value="{StaticResource TypeScreen}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="{StaticResource TypeTitle}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="{StaticResource TypeCaption}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="{StaticResource TypeCaption}" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="{StaticResource TypeEyebrow}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="TextBlock.data">
            <Setter Property="FontFamily" Value="{StaticResource FontData}" />
            <Setter Property="FontSize" Value="{StaticResource TypeBodySmall}" />
        </Style>
        <Style Selector="TextBlock.teal">
            <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
            <Setter Property="Padding" Value="{StaticResource PadCard}" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        </Style>
        <Style Selector="Border.card.dense">
            <Setter Property="Padding" Value="{StaticResource PadCardDense}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        </Style>
        <Style Selector="ListBox.dense ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <Style Selector="StackPanel.denseFields TextBox, StackPanel.denseFields ComboBox, StackPanel.denseFields NumericUpDown">
            <Setter Property="MinHeight" Value="{StaticResource HitTargetCompact}" />
        </Style>
        <Style Selector="StackPanel.denseFields TextBox">
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="Border.lessonCard">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="148" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
            <Setter Property="Padding" Value="{StaticResource PadCard}" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <Style Selector="Border.lessonCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Border.subcard">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Padding" Value="{StaticResource PadSubcard}" />
        </Style>
        <Style Selector="Border.status">
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>
        <Style Selector="Border.headerBar">
            <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="{StaticResource HitTarget}" />
            <Setter Property="Padding" Value="{StaticResource PadButton}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
        </Style>
        <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.48" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource TealBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnTealBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="{StaticResource PadButton}" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TealBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource OnTealBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TealHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealHoverBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource OnTealBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TealHoverBrush}" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="Foreground" Value="#13181D" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="{StaticResource PadButton}" />
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="TextElement.Foreground" Value="#13181D" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0AA00" />
            <Setter Property="BorderBrush" Value="#F0AA00" />
            <Setter Property="TextElement.Foreground" Value="#13181D" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0AA00" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#AD3037" />
            <Setter Property="BorderBrush" Value="#AD3037" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#AD3037" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
        </Style>

        <Style Selector="Button.checkMark">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.checkMark Path.checkIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Fill" Value="{DynamicResource InkBrush}" />
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <Style Selector="Button.checkMark.primary Path.checkIcon">
            <Setter Property="Fill" Value="{DynamicResource OnTealBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.checkMark.ghost Path.checkIcon">
            <Setter Property="Fill" Value="{DynamicResource InkBrush}" />
        </Style>

        <Style Selector="Button.themeToggle Path">
            <Setter Property="Fill" Value="{DynamicResource InkBrush}" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.themeToggle Path.themeSun">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Button.themeToggle.dark Path.themeSun">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="Button.themeToggle Path.themeMoon">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Button.themeToggle.dark Path.themeMoon">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="Button.themeToggle:pointerover Path">
            <Setter Property="Fill" Value="{DynamicResource TealBrush}" />
        </Style>

        <Style Selector="Border.segmentBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="Button.segment">
            <Setter Property="MinHeight" Value="{StaticResource HitTarget}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.segment /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Button.segment.active">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.segment.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Button.segment.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TealBrush}" />
        </Style>

        <Style Selector="Button.listCard">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.listCard /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.listCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.listCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.listCardInner">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
            <Setter Property="Padding" Value="{StaticResource PadCard}" />
        </Style>
        <Style Selector="Border.listCardInner:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
        </Style>
        <Style Selector="Border.listCardInner.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        </Style>
        <Style Selector="Border.listCardInner.selected:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
            <Setter Property="Background" Value="{DynamicResource MintBrush}" />
        </Style>
        <Style Selector="Button.listCard:pointerover Border.card">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
        </Style>
        <Style Selector="Border.notice">
            <Setter Property="Background" Value="{DynamicResource AmberSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Button.commandRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
