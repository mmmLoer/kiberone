[Unit]
Description=KIBERone student incoming mail API
After=network.target postfix.service

[Service]
Type=simple
WorkingDirectory=/opt/kiberone-mail-api
ExecStart=/opt/kiberone-mail-api/Kiberone.MailApi
Environment=KIBERONE_HUB_DATA=/var/lib/kiberone-hub
Environment=KIBERONE_HUB_SECRETS=/var/lib/kiberone-hub/location-secrets.json
Environment=KIBERONE_MAIL_API_LISTEN=http://127.0.0.1:8790
Environment=KIBERONE_MAILDIR_ROOT=/var/mail/nshub/students.nshub.pro
Environment=KIBERONE_MAIL_PROVISION_SCRIPT=/opt/kiberone-mail-api/provision-student-mailbox.sh
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/kiberone-mail-api
RuntimeDirectory=kiberone-mail-api
RuntimeDirectoryMode=0700
StateDirectory=kiberone-mail-api
StateDirectoryMode=0700
UMask=0077
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
ReadWritePaths=/var/lib/kiberone-mail-api /var/lib/kiberone-hub/mail-accounts /var/lib/kiberone-hub/rosters /var/mail/nshub /etc/postfix /run/kiberone-mail-api
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
